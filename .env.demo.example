# Template do .env.demo — a INSTÂNCIA DE DEMONSTRAÇÃO pública do Consulta ISP.
#
# Isto documenta o .env real da demo (server/env.ts, .env.example e o código
# citado em cada comentário são a fonte — não o plano). Copie para ".env.demo"
# na VPS, preencha os valores marcados, e NUNCA preencha a seção "NUNCA
# PREENCHER AQUI": é isso que garante que um bug na demo não gasta dinheiro
# nem consulta pessoa real. Ver docs/demo-instancia-2026-09-12.md para o
# roteiro completo (banco, nginx, pm2, primeira carga).
#
# NODE_ENV nao entra aqui: ecosystem.demo.config.cjs forca "production" para
# os dois processos, sempre, por cima de qualquer valor deste arquivo.

# ============================================================================
# OBRIGATÓRIAS — sem qualquer uma destas o processo cai em process.exit(1)
# no boot (REQUIRED_VARS, server/env.ts:3). Sem exceção, sem modo demo.
# ============================================================================

# Connection string do banco PRÓPRIO da demo (nunca o de produção).
# Ex.: postgresql://demo:<senha gerada na VPS>@localhost:5432/consultaispdemo
DATABASE_URL=

# Aleatória, só desta instância — nunca reaproveite a de produção (rotacionar
# esta variável derruba toda sessão viva, inclusive de sandboxes abertos).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ============================================================================
# A CHAVE DO MODO DEMO — sem ela isto é um provedor de produção comum
# ============================================================================

# A ÚNICA leitura de comportamento que distingue esta instância da de
# produção (emModoDemo(), server/demo/modo-demo.ts). Precisa ser exatamente a
# string "true" — qualquer outro valor ("1", "TRUE", "sim") é tratado como
# desligado, de propósito (um DEMO_MODE=1 esquecido em produção não pode virar
# demonstração sozinho).
DEMO_MODE=true

# Porta do processo HTTP. 5001 não colide com a produção (5000, .env.example)
# nem com outros serviços já na VPS (Evolution API em 8080).
PORT=5001

# ============================================================================
# RECOMENDADAS — nunca derrubam o boot sozinhas, mas fazem a demo se comportar
# melhor. Pode subir sem elas; devolvidas aqui para não esquecer depois.
# ============================================================================

# AUSENTE é seguro (deriva de SESSION_SECRET, só um aviso no log — server/
# env.ts:15-23). PRESENTE E CURTA NÃO é: menos de 32 caracteres É FATAL no
# boot. Ou gere 32+ caracteres com o mesmo comando de SESSION_SECRET, ou
# deixe a linha vazia — nunca um valor curto "de teste".
PARTNER_CODE_SECRET=

# Hash de CPF/endereço para a rede colaborativa. Ausente = só aviso no log
# (server/env.ts:12-14), mas sem ele o conector demo e a varredura ainda
# funcionam normalmente — é puramente sobre a qualidade do log de boot.
NETWORK_CPF_SALT=

# Identificação do controlador na política pública /lgpd. Ausente = só aviso
# no log, e só quando NODE_ENV=production (server/env.ts:105-136); a página
# publica um CNPJ-placeholder em vez de travar. Ainda assim, é a MESMA empresa
# real por trás da demo — preencher com o valor real de produção é o correto,
# não um dado fictício.
LGPD_EMPRESA=
LGPD_CNPJ=
LGPD_DPO_EMAIL=
LGPD_ADMIN_EMAIL=

# Cria um login de superadmin PRÓPRIO desta instância (server/seed.ts:492-509,
# roda sempre, independente de NODE_ENV). Sem as duas, o seed é pulado em
# silêncio — só um aviso no log — e a única forma de entrar na demo continua
# sendo o sandbox efêmero de cada visitante. Recomendado para o dono poder
# inspecionar a base da demo sem depender de um sandbox de 24h.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# NÃO defina como "demo.consultaisp.com.br". MAIN_DOMAIN é o domínio RAIZ da
# PLATAFORMA (server/tenant.ts:8, default "consultaisp.com.br" se ausente) —
# é contra ele que o servidor calcula subdomínio de provedor
# (<sub>.<MAIN_DOMAIN>). O host da demo já É um subdomínio desse domínio raiz;
# apontar MAIN_DOMAIN para o próprio host da demo quebra essa conta. Deixe
# esta linha vazia (o default já é o valor correto).
MAIN_DOMAIN=

# Base dos links de e-mail. Na prática não importa aqui: em DEMO_MODE nenhum
# e-mail sai (server/services/email.ts, guarda da Tarefa 1) — documentado só
# para não parecer esquecido.
APP_URL=

# NÃO é o seed desta feature. SEED_DEMO_DATA controla um seed ANTIGO e
# genérico (server/seed.ts:7-15, providers fictícios tipo "NsLink Provedor")
# que já sai bloqueado sempre que NODE_ENV=production — e os dois processos
# da demo sempre sobem em NODE_ENV=production (ecosystem.demo.config.cjs).
# Portanto esta variável é irrelevante aqui de qualquer forma; deixe ausente
# ou "false" para não confundir com semearMundoBase() (server/demo/
# mundo-base.ts), que é o seed de verdade da demo e roda por outro caminho —
# ver docs/demo-instancia-2026-09-12.md.
SEED_DEMO_DATA=false

# ============================================================================
# NUNCA PREENCHER AQUI — ausência deliberada, não esquecimento.
#
# Em DEMO_MODE a rede, o SPC e a cadastral são simulados (server/demo/
# bureaus-simulados.ts) e e-mail/WhatsApp/webhook/ZapSign saem silenciosamente
# sem chamar nada (Tarefa 1 e a ausência de credencial abaixo, design doc
# §3.1/§3.6). Preencher QUALQUER uma destas variáveis reintroduz o que a
# instância separada existe para evitar: um bug aqui passaria a gastar
# dinheiro de verdade ou consultar o CPF de uma pessoa real. Se algum dia uma
# equipe precisar demonstrar uma dessas integrações ao vivo, isso é uma
# decisão nova do dono, não um valor que se cola neste arquivo.
# ============================================================================

# Resend — e-mail transacional. Sem ela, nenhum e-mail sai (é redundante com
# a guarda de DEMO_MODE, mas a ausência é a segunda trava, não a primeira).
RESEND_API_KEY=

# Asaas — pagamento PIX/Boleto real. POST /api/credits/purchase já recusa em
# DEMO_MODE (Tarefa 9); sem a chave, nem chegaria a autenticar.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# OpenAI — análise de IA com custo por token, e os três agentes de cobrança
# do Chat BullQ (que fariam chamada real de LLM se ligados).
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_ANALYSIS_MODEL=

# Google Maps — cobrado por carregamento no mapa de calor.
GOOGLE_MAPS_API_KEY=

# SPC Brasil — WebService de consulta real (SOAP), cobrado por CPF consultado.
# Sem estas, a rota já fica desligada (503) independente do modo demo.
SPC_USERNAME=
SPC_PASSWORD=
SPC_WSDL_URL=
SPC_PRODUCT_CODE=
SPC_INSUMOS_OPCIONAIS=

# BigDataCorp — consulta cadastral real, cobrada por CPF/CNPJ.
BIGDATA_PLATAFORMA_LOGIN=
BIGDATA_PLATAFORMA_SENHA=

# Z-API — WhatsApp real dos avisos de anti-fraude (server/services/crm/zapi.ts).
# Preenchida, o alerta de fuga de um sandbox manda mensagem de verdade pro
# telefone de contato de um provedor de PRODUÇÃO (o dono que "recebe" o
# alerta é resolvido pela regra de anti-fraude, não pela instância).
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Chat BullQ — fork privado de atendimento (WhatsApp real via Zappfy/Uazapi/
# Datafy, e execução real de agente de IA). Sem CHAT_BULLQ_URL o chat fica
# inteiramente desligado na tela.
CHAT_BULLQ_URL=
CHAT_BULLQ_PLATFORM_KEY=
CHAT_BULLQ_PUBLIC_URL=
CHAT_BULLQ_INBOX_URL=
CHAT_BULLQ_AGENTE_URL=
CHAT_BULLQ_WEBHOOK_URL=
CHAT_BULLQ_AGENTE_MODELO=
CHAT_BULLQ_TOOLS_HOSTS=

# ZapSign — assinatura eletrônica real de confissão de dívida (custo por
# envio, e gera documento com efeito jurídico).
ASSINATURA_WEBHOOK_URL=

# Focus NFe — emissão fiscal real de NFS-e (server/services/focusnfe.ts),
# cobrada por nota e com efeito fiscal/jurídico de verdade.
FOCUS_NFE_TOKEN=
