+  it('rejects Meta signatures for a Datafy channel and cannot route only by WABA', () => {
+    expect(adapter.validateWebhook({ 'x-hub-signature-256': 'sha256=' + 'a'.repeat(64) }, raw, channel.webhookSecret!, channel)).toBe(false);
+    expect(adapter.matchesChannel(channel, { businessAccountId: '67890' })).toBe(false);
