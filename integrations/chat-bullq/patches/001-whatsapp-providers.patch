+  status: 'disconnected' | 'connecting' | 'connected' | 'unknown';
+  connected: boolean;
+  loggedIn: boolean;
+  phone: string | null;
+  qrCode: string | null;
+  pairCode: string | null;
+}
+
+function record(value: unknown): Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+    ? value as Record<string, unknown> : {};
+}
+
+/** Do not spread provider responses: Instance includes token and openai_apikey. */
+export function sanitizeZappfyConnection(payload: unknown, provider: 'ZAPPFY' | 'UAZAPI' = 'ZAPPFY'): ZappfyConnectionStatus {
+  const body = record(payload);
+  const instance = record(body.instance);
+  const flags = typeof body.status === 'object' ? record(body.status) : body;
+  const loggedIn = flags.loggedIn === true;
+  const connected = flags.connected === true && loggedIn;
+  const reported = instance.status;
+  const status: ZappfyConnectionStatus['status'] = connected ? 'connected'
+    : reported === 'connecting' ? 'connecting'
+    : reported === 'disconnected' || reported === 'hibernated' ? 'disconnected' : 'unknown';
+  const user = record(flags.jid).user;
+  const phone = typeof user === 'string' && /^\d{10,15}$/.test(user) ? user : null;
+  const qr = instance.qrcode;
+  const pair = instance.paircode;
+  // QR is ephemeral authentication data. Allow only inline PNG, never HTML,
+  // SVG, or a URL that would cause the operator's browser to fetch a third party.
+  const validQr = typeof qr === 'string' && qr.length <= 499_978
+    && /^(?:data:image\/png;base64,)?iVBORw0KGgo[A-Za-z0-9+/]*={0,2}$/.test(qr);
+  return {
+    provider, status, connected, loggedIn, phone,
+    qrCode: status === 'connecting' && validQr
+      ? (qr.startsWith('data:') ? qr : `data:image/png;base64,${qr}`) : null,
+    pairCode: status === 'connecting' && typeof pair === 'string' && /^[A-Za-z0-9]{4}-?[A-Za-z0-9]{4}$/.test(pair) ? pair : null,
+  };
+}
