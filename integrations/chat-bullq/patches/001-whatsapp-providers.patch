+    { resolveByLocator: () => channel } as never,
+    { record } as never, { add } as never,
+  );
+  const rawBody = Buffer.from(JSON.stringify(payload));
+  const timestamp = String(Math.floor(Date.now()/1000));
+  const headers = { 'x-datafy-delivery-id': '11111111-1111-4111-8111-111111111111', 'x-datafy-timestamp': timestamp,
+    'x-datafy-signature-256': 'sha256=' + createHmac('sha256','whsec_fixture').update(`${timestamp}.`).update(rawBody).digest('hex') };
+  const res = { status: jest.fn().mockReturnThis(), json: jest.fn() };
+  beforeEach(() => jest.clearAllMocks());
+
+  it('uses the same retained Redis job ID for a replay, even if unsigned delivery-id is changed', async () => {
+    for (const id of ['11111111-1111-4111-8111-111111111111','22222222-2222-4222-8222-222222222222']) {
+      await gateway.handleWebhook(ChannelType.WHATSAPP_OFFICIAL, { body: payload, rawBody, headers: { ...headers, 'x-datafy-delivery-id': id } } as never, res as never);
+    }
+    expect(add).toHaveBeenCalledTimes(2);
+    expect(add.mock.calls[0][2].jobId).toEqual(add.mock.calls[1][2].jobId);
+    expect(add.mock.calls[0][2]).toEqual(expect.objectContaining({ removeOnComplete: { age: 604800 }, removeOnFail: false }));
