+import 'reflect-metadata';
+import { BadRequestException, ForbiddenException, NotFoundException } from '@nestjs/common';
+import { ChannelType, OrgRole } from '@prisma/client';
+import { validate } from 'class-validator';
+import { ChannelsController } from './channels.controller';
+import { ChannelsService } from './channels.service';
+import { ConnectChannelDto } from './dto/connect-channel.dto';
+
+describe('Channel connection permissions', () => {
+  const channel = { id: 'channel-a', organizationId: 'org-a', type: ChannelType.WHATSAPP_ZAPPFY, isActive: true };
+  const repository = { findById: jest.fn() };
+  const zappfy = { connectInstance: jest.fn(), getConnectionStatus: jest.fn() };
+  const service = new ChannelsService(
+    repository as never, {} as never, zappfy as never, {} as never,
+    {} as never, {} as never, {} as never, {} as never, {} as never,
+  );
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    repository.findById.mockResolvedValue(channel);
+  });
+
+  it('requires OWNER/ADMIN and disables response caching on both pairing endpoints', () => {
+    for (const name of ['connect', 'connectionStatus'] as const) {
+      const method = ChannelsController.prototype[name];
+      expect(Reflect.getMetadata('roles', method)).toEqual([OrgRole.OWNER, OrgRole.ADMIN]);
+      expect(Reflect.getMetadata('__headers__', method)).toContainEqual({ name: 'Cache-Control', value: 'no-store' });
+    }
+  });
+
+  it('advertises connection support on a static path before channel IDs', () => {
+    const controller = new ChannelsController(service);
+    expect(controller.capabilities()).toEqual(expect.objectContaining({ whatsappUnofficial: true, instanceConnect: true, instanceStatus: true, provider: 'ZAPPFY', uazapi: true, datafy: true, templateFirstContact: true }));
+    expect(Reflect.getMetadata('path', controller.capabilities)).toBe('capabilities');
+  });
+
+  it('blocks a channel in another organization before any network call', async () => {
+    await expect(service.connect('channel-a', 'org-b', {}, 'ALL')).rejects.toBeInstanceOf(ForbiddenException);
+    await expect(service.connectionStatus('channel-a', 'org-b', 'ALL')).rejects.toBeInstanceOf(ForbiddenException);
+    expect(zappfy.connectInstance).not.toHaveBeenCalled();
+    expect(zappfy.getConnectionStatus).not.toHaveBeenCalled();
+  });
+
+  it('honors restricted channel grants even for organization administrators', async () => {
+    await expect(service.connect('channel-a', 'org-a', {}, new Set())).rejects.toBeInstanceOf(ForbiddenException);
+    expect(zappfy.connectInstance).not.toHaveBeenCalled();
+  });
+
+  it('does not connect inactive, missing, or other channel types', async () => {
+    repository.findById.mockResolvedValue({ ...channel, isActive: false });
+    await expect(service.connect('channel-a', 'org-a', {}, 'ALL')).rejects.toBeInstanceOf(BadRequestException);
+    repository.findById.mockResolvedValue({ ...channel, type: ChannelType.WHATSAPP_OFFICIAL });
+    await expect(service.connect('channel-a', 'org-a', {}, 'ALL')).rejects.toBeInstanceOf(BadRequestException);
+    repository.findById.mockResolvedValue(null);
+    await expect(service.connect('missing', 'org-a', {}, 'ALL')).rejects.toBeInstanceOf(NotFoundException);
+    expect(zappfy.connectInstance).not.toHaveBeenCalled();
+  });
+
+  it('calls only the selected organization channel', async () => {
+    zappfy.connectInstance.mockResolvedValue({ status: 'connecting' });
+    await expect(service.connect('channel-a', 'org-a', { phone: '5511999999999' }, new Set(['channel-a']))).resolves.toEqual({ status: 'connecting' });
+    expect(zappfy.connectInstance).toHaveBeenCalledWith(channel, '5511999999999');
+  });
+
+  it('validates optional phone digits and rejects request token/base URL overrides', async () => {
+    expect(await validate(Object.assign(new ConnectChannelDto(), {}))).toHaveLength(0);
+    expect(await validate(Object.assign(new ConnectChannelDto(), { phone: '5511999999999' }))).toHaveLength(0);
+    expect(await validate(Object.assign(new ConnectChannelDto(), { phone: '+55 abc' }))).not.toHaveLength(0);
+    expect(await validate(Object.assign(new ConnectChannelDto(), { baseUrl: 'https://attacker.invalid', token: 'override' }), { whitelist: true, forbidNonWhitelisted: true })).not.toHaveLength(0);
+  });
+});
