+++ b/src/modules/channel-hub/adapters/whatsapp-official/datafy-webhook.ts
@@ -0,0 +1,22 @@
+import { createHash, createHmac, timingSafeEqual } from 'crypto';
+
+export function validateDatafyWebhook(headers: Record<string, string>, raw: Buffer, secret?: string): boolean {
+  const timestamp = headers['x-datafy-timestamp'];
+  const signature = headers['x-datafy-signature-256'];
+  const deliveryId = headers['x-datafy-delivery-id'];
+  if (!secret?.startsWith('whsec_') || !/^\d{10}$/.test(timestamp ?? '')
+    || !/^sha256=[a-f0-9]{64}$/.test(signature ?? '')
+    || !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(deliveryId ?? '')) return false;
+  if (Math.abs(Math.floor(Date.now() / 1000) - Number(timestamp)) > 300) return false;
+  const expected = 'sha256=' + createHmac('sha256', secret).update(`${timestamp}.`).update(raw).digest('hex');
+  return timingSafeEqual(Buffer.from(signature), Buffer.from(expected));
+}
+
+/** Redis/BullMQ job IDs are atomic across processes. Retain successful jobs
+ * longer than the signature window; failures stay retryable in the same job.
+ * The digest uses signed bytes, because delivery-id itself is not HMAC-signed.
+ * Changing an unsigned delivery header must not bypass replay protection. */
+export function datafyJobOptions(channelId: string, raw: Buffer, kind: string, externalId: string) {
+  const digest = createHash('sha256').update(JSON.stringify([channelId, kind, externalId])).update(raw).digest('hex');
+  return { jobId: `datafy-${digest}`, removeOnComplete: { age: 7 * 24 * 60 * 60 }, removeOnFail: false as const };
+}
