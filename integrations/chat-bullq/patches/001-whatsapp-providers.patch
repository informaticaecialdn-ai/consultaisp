+    await gateway.handleWebhook(ChannelType.WHATSAPP_OFFICIAL, { body: payload, rawBody, headers: { ...headers, 'x-datafy-signature-256': 'sha256=' + '0'.repeat(64) } } as never, res as never);
+    expect(add).not.toHaveBeenCalled();
+    expect(record).not.toHaveBeenCalled();
+  });
+
+  it('keeps delivered and read transitions for the same message in one signed batch', async () => {
+    const body = { entry: [{ id: '67890', changes: [{ value: { metadata: { phone_number_id: '12345' }, statuses: [
+      { id: 'wamid.fixture', status: 'delivered', timestamp }, { id: 'wamid.fixture', status: 'read', timestamp },
+    ] } }] }] };
+    const raw = Buffer.from(JSON.stringify(body));
+    const signed = { ...headers, 'x-datafy-signature-256': 'sha256=' + createHmac('sha256', 'whsec_fixture').update(`${timestamp}.`).update(raw).digest('hex') };
+    await gateway.handleWebhook(ChannelType.WHATSAPP_OFFICIAL, { body, rawBody: raw, headers: signed } as never, res as never);
