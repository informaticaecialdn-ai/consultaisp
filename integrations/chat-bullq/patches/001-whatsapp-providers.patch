+    expect(adapter.validateWebhook({ ...headers(), 'x-datafy-delivery-id': '' }, raw, channel.webhookSecret!, channel)).toBe(false);
+    expect(adapter.validateWebhook(headers(), raw, 'whsec_other', channel)).toBe(false);
