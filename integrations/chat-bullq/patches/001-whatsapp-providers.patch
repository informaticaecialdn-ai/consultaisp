+    await adapter.sendMessage(channel, '5511999999999', { type: MessageContentType.TEXT, content: { text: 'hello' } });
+    expect(findFirst).toHaveBeenCalledWith(expect.objectContaining({ where: expect.objectContaining({ direction: 'INBOUND', conversation: expect.objectContaining({ organizationId: 'org-a', channelId: 'channel-a' }) }) }));
+    expect(sendMessage).toHaveBeenCalledTimes(1);
