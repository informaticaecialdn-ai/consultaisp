+
+  it('rejects phone IDs that do not belong to the supplied token', async () => {
+    get.mockResolvedValue({ data: { phone_number_id: '000', data: [] } });
+    await expect(client.verifyPhoneNumber(channel)).rejects.toThrow();
+  });
