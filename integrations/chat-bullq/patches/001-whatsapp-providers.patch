+import { BadRequestException } from '@nestjs/common';
+
+export function resolveUnofficialConfig(config: Record<string, unknown>): {
+  provider: 'ZAPPFY' | 'UAZAPI'; baseUrl: string; token: string;
+} {
+  const provider = config.provider ?? 'ZAPPFY';
+  if (provider !== 'ZAPPFY' && provider !== 'UAZAPI') throw new BadRequestException('Provider WhatsApp não oficial inválido.');
+  if (typeof config.token !== 'string' || !config.token.trim() || /[\r\n]/.test(config.token)) throw new BadRequestException('Token da instância é obrigatório.');
+  if (provider === 'ZAPPFY') return { provider, baseUrl: 'https://api.zappfy.io', token: config.token };
+  try {
+    if (typeof config.baseUrl !== 'string') throw new Error('URL required');
+    const url = new URL(config.baseUrl);
+    const allowedHosts = (process.env.UAZAPI_ALLOWED_HOSTS ?? '').split(',').map(host => host.trim().toLowerCase()).filter(Boolean);
+    const publicHost = /^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$/.test(url.hostname);
+    const allowed = url.hostname.endsWith('.uazapi.com') || allowedHosts.includes(url.hostname);
+    if (!publicHost || !allowed || url.protocol !== 'https:' || url.username || url.password || url.port || url.pathname !== '/' || url.search || url.hash) throw new Error('Unsafe URL');
+    return { provider, baseUrl: url.origin, token: config.token };
+  } catch {
+    throw new BadRequestException('Informe a origem HTTPS da instância Uazapi autorizada, sem caminho, porta ou credenciais.');
+  }
+}
