+const payload = { entry: [{ id: '67890', changes: [{ value: { metadata: { phone_number_id: '12345' }, messages: [{ id: 'wamid.fixture', from: '5511999999999', type: 'text', text: { body: 'Oi' }, timestamp: String(Math.floor(Date.now()/1000)) }] } }] }] };
