@@ -0,0 +1,48 @@
+import { ConversationStatus } from '@prisma/client';
+import { validate } from 'class-validator';
+import { plainToInstance } from 'class-transformer';
+import { MessagesService } from '../messages/messages.service';
+import { StartConversationDto } from './dto/start-conversation.dto';
+import { ConversationFsmService } from './conversation-fsm.service';
+import { PrismaService } from '../../../database/prisma.service';
+import { RatingsService } from '../../ratings/ratings.service';
+import { OutboxService } from '../../automations/outbox/outbox.service';
+
+it('accepts an explicitly paused first contact, rejecting attempts to start automatic replies', async () => {
+  const input = { channelId: 'ch', contact: { phone: '5511999999999' }, message: { type: 'TEXT', content: { text: 'Olá' } } };
+  expect(await validate(plainToInstance(StartConversationDto, { ...input, aiEnabled: false }), { whitelist: true, forbidNonWhitelisted: true })).toEqual([]);
+  expect((await validate(plainToInstance(StartConversationDto, { ...input, aiEnabled: true }), { whitelist: true, forbidNonWhitelisted: true })).length).toBeGreaterThan(0);
+});
+
+it('pauses a reused conversation in its organization before enqueuing the first contact', async () => {
+  let paused = false;
+  const prisma = {
+    channel: { findUnique: jest.fn().mockResolvedValue({ id: 'ch', organizationId: 'org', type: 'WHATSAPP_ZAPPFY' }) },
+    conversation: { updateMany: jest.fn().mockImplementation(async () => { paused = true; return { count: 1 }; }) },
+  };
+  const send = jest.fn().mockImplementation(async () => { expect(paused).toBe(true); return { id: 'msg', conversationId: 'conv' }; });
+  const service = {
+    prisma, send,
+    channelAccess: { assertChannelAccess: jest.fn() },
+    contactResolver: { resolveManual: jest.fn().mockResolvedValue({ contactId: 'contact' }) },
+    conversationResolver: { resolveForOperator: jest.fn().mockResolvedValue({ conversationId: 'conv' }) },
+  } as unknown as MessagesService;
+  const dto = plainToInstance(StartConversationDto, { channelId: 'ch', contact: { phone: '5511999999999' }, message: { type: 'TEXT', content: { text: 'Olá' } }, aiEnabled: false });
+  await MessagesService.prototype.startConversation.call(service, dto, 'owner', 'org');
+  expect(prisma.conversation.updateMany).toHaveBeenCalledWith(expect.objectContaining({
+    where: { id: 'conv', organizationId: 'org' }, data: expect.objectContaining({ aiEnabled: false, activeAgentId: null, aiDisabledBy: 'owner' }),
+  }));
+  expect(send).toHaveBeenCalledTimes(1);
+});
+
+it('returns outbound outreach to PENDING and releases the technical owner', async () => {
+  const tx = { conversation: { update: jest.fn() }, conversationAuditLog: { create: jest.fn() } };
+  const prisma = {
+    conversation: { findUniqueOrThrow: jest.fn().mockResolvedValue({ id: 'conv', status: 'OPEN', organizationId: 'org', contactId: 'contact', channelId: 'ch' }) },
+    $transaction: jest.fn().mockImplementation(async (fn: (transaction: typeof tx) => Promise<void>) => fn(tx)),
+  };
+  const service = new ConversationFsmService(prisma as unknown as PrismaService, {} as RatingsService, { enqueue: jest.fn() } as unknown as OutboxService);
+  expect(service.canTransition(ConversationStatus.OPEN, ConversationStatus.PENDING)).toBe(true);
+  await service.transition('conv', ConversationStatus.PENDING, 'owner');
+  expect(tx.conversation.update).toHaveBeenCalledWith(expect.objectContaining({ data: expect.objectContaining({ status: 'PENDING', assignedToId: null }) }));
+});
