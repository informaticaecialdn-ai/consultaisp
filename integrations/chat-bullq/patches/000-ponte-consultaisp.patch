+++ b/src/modules/platform/platform.spec.ts
@@ -0,0 +1,91 @@
+import { ConfigService } from '@nestjs/config';
+import { ExecutionContext } from '@nestjs/common';
+import { PlatformKeyGuard } from './platform-key.guard';
+import { PlatformService } from './platform.service';
+import { PrismaService } from '../../database/prisma.service';
+import { AuthService } from '../auth/auth.service';
+
+const key = 'test-platform-key-with-at-least-32-characters';
+const context = (header: unknown) => ({
+  switchToHttp: () => ({ getRequest: () => ({ headers: { 'x-platform-key': header } }) }),
+}) as ExecutionContext;
+
+describe('PlatformKeyGuard', () => {
+  it('fails closed with no key and rejects missing, wrong or duplicate credentials', () => {
+    expect(() => new PlatformKeyGuard(new ConfigService({})).canActivate(context(key))).toThrow();
+    const guard = new PlatformKeyGuard(new ConfigService({ PLATFORM_API_KEY: key }));
+    for (const bad of [undefined, 'wrong', [key, key]]) expect(() => guard.canActivate(context(bad))).toThrow();
+    expect(guard.canActivate(context(key))).toBe(true);
+  });
+});
+
+describe('PlatformService ownership boundary', () => {
+  function setup(settings: object = { consultaIsp: { externalId: '42', ownerUserId: 'owner' } }) {
+    const prisma = {
+      organization: { findUnique: jest.fn().mockResolvedValue({ id: 'org', slug: 'isp-42', settings, deletedAt: null }) },
+      userOrganization: {
+        findFirst: jest.fn().mockResolvedValue({ userId: 'owner', user: { id: 'owner', email: 'owner@example.com', isActive: true } }),
+        count: jest.fn().mockResolvedValue(1),
+      },
+      user: { update: jest.fn().mockResolvedValue({}) },
+    };
+    const auth = { issueTokensForUser: jest.fn().mockResolvedValue({ accessToken: 'access', refreshToken: 'refresh' }) };
+    return { prisma, auth, service: new PlatformService(prisma as unknown as PrismaService, auth as unknown as AuthService) };
+  }
+
+  it('only issues existing AuthService tokens after checking active dedicated OWNER membership', async () => {
+    const { prisma, auth, service } = setup();
+    expect(await service.tokens('org')).toEqual({ accessToken: 'access', refreshToken: 'refresh' });
+    expect(prisma.userOrganization.findFirst).toHaveBeenCalledWith(expect.objectContaining({ where: { organizationId: 'org', userId: 'owner', role: 'OWNER' } }));
+    expect(auth.issueTokensForUser).toHaveBeenCalledWith('owner');
+  });
+
+  it('does not issue tokens for unmanaged, deleted, inactive or cross-workspace owners', async () => {
+    const unmanaged = setup({});
+    await expect(unmanaged.service.tokens('org')).rejects.toThrow();
+    expect(unmanaged.auth.issueTokensForUser).not.toHaveBeenCalled();
+    for (const failure of ['deleted', 'inactive', 'multiple', 'missing']) {
+      const { prisma, auth, service } = setup();
+      if (failure === 'deleted') prisma.organization.findUnique.mockResolvedValueOnce({ deletedAt: new Date() });
+      if (failure === 'inactive') prisma.userOrganization.findFirst.mockResolvedValueOnce({ user: { isActive: false } });
+      if (failure === 'multiple') prisma.userOrganization.count.mockResolvedValueOnce(2);
+      if (failure === 'missing') prisma.userOrganization.findFirst.mockResolvedValueOnce(null);
+      await expect(service.tokens('org')).rejects.toThrow();
+      expect(auth.issueTokensForUser).not.toHaveBeenCalled();
+    }
+  });
+
+  it('reuses the same external identity without creating another owner or resetting its password', async () => {
+    const { prisma, service } = setup();
+    let saved: { id: string; slug: string; settings: object; deletedAt: null } | null = null;
+    prisma.organization.findUnique.mockImplementation(async () => saved);
+    const transaction = {
+      user: { findUnique: jest.fn().mockResolvedValue(null), create: jest.fn().mockResolvedValue({ id: 'owner' }) },
+      organization: { create: jest.fn().mockImplementation(async ({ data }: { data: { id: string; slug: string; settings: object } }) => { saved = { ...data, deletedAt: null }; return saved; }) },
+      userOrganization: { findUniqueOrThrow: jest.fn().mockResolvedValue({ id: 'membership' }) },
+      department: { create: jest.fn().mockResolvedValue({ id: 'department' }) },
+    };
+    const transact = jest.fn().mockImplementation(async (fn: (tx: typeof transaction) => Promise<void>) => fn(transaction));
+    Object.assign(prisma, { $transaction: transact });
+    const dto = { name: 'Provedor', ownerName: 'Dono', ownerEmail: 'OWNER@example.com', slug: 'isp-42', externalId: '42' };
+    const first = await service.provision(dto);
+    const again = await service.provision({ ...dto, slug: 'changed-slug', ownerPassword: 'this-must-not-reset-password' });
+    expect(first.created).toBe(true);
+    expect(again).toEqual({ ...first, created: false });
+    expect(again.slug).toBe('isp-42');
+    expect(transact).toHaveBeenCalledTimes(1);
+    expect(transaction.user.create).toHaveBeenCalledTimes(1);
+    expect(prisma.user.update).not.toHaveBeenCalled();
+  });
+
+  it('rejects a provision that would claim another owner email or an existing unrelated account', async () => {
+    const existing = setup();
+    await expect(existing.service.provision({ name: 'Provedor', ownerName: 'Dono', ownerEmail: 'other@example.com', externalId: '42' })).rejects.toThrow();
+    const missing = setup();
+    missing.prisma.organization.findUnique.mockResolvedValue(null);
+    const create = jest.fn();
+    Object.assign(missing.prisma, { $transaction: async (fn: (tx: object) => Promise<void>) => fn({ user: { findUnique: jest.fn().mockResolvedValue({ id: 'unrelated' }), create } }) });
+    await expect(missing.service.provision({ name: 'Provedor', ownerName: 'Dono', ownerEmail: 'other@example.com', externalId: '42' })).rejects.toThrow();
+    expect(create).not.toHaveBeenCalled();
+  });
+});
