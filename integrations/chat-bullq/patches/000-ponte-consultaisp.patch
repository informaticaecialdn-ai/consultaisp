+import { Injectable } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { createHmac } from 'node:crypto';
+import { setTimeout as delay } from 'node:timers/promises';
+import { ActionContext, ActionExecutionResult, ActionHandler } from '../action.types';
+
+@Injectable()
+export class CallWebhookHandler implements ActionHandler {
+  readonly type = 'call_webhook' as const;
+  readonly continueOnErrorDefault = false;
+  constructor(private readonly config: ConfigService) {}
+
+  validateParams(params: Record<string, unknown>): void {
+    const allowed = this.config.get<string>('CONSULTA_ISP_WEBHOOK_URL') || 'https://consultaisp.com.br/api/webhooks/chat-bullq';
+    let target: URL;
+    try { target = new URL(String(params.url)); } catch { throw new Error('call_webhook: invalid destination'); }
+    const localDevelopment = this.config.get<string>('NODE_ENV') === 'development'
+      && target.href === 'http://127.0.0.1:5000/api/webhooks/chat-bullq';
+    if ((target.protocol !== 'https:' && !localDevelopment) || target.username || target.password || target.hash || target.search || target.href !== allowed) {
+      throw new Error('call_webhook: destination must match the server-configured Consulta ISP HTTPS endpoint or the exact development loopback callback');
+    }
+    if (typeof params.secret !== 'string' || params.secret.length < 16 || params.secret.length > 200) {
+      throw new Error('call_webhook: secret must contain 16 to 200 characters');
+    }
+  }
+
+  async execute(params: Record<string, unknown>, ctx: ActionContext): Promise<ActionExecutionResult> {
+    try { this.validateParams(params); } catch {
+      return { ok: false, errorCode: 'invalid_params', errorMessage: 'Webhook destination or secret is invalid' };
+    }
+    const { payload, organizationId, prisma } = ctx;
+    if (payload.organizationId !== organizationId || !payload.conversationId) {
+      return { ok: false, errorCode: 'invalid_ref', errorMessage: 'Webhook requires a conversation in this organization' };
+    }
+    const conversation = await prisma.conversation.findFirst({ where: {
+      id: payload.conversationId, organizationId, contactId: payload.contactId, deletedAt: null,
+    }, select: { id: true } });
+    if (!conversation) return { ok: false, errorCode: 'invalid_ref', errorMessage: 'Conversation not found in this organization' };
+    if ('messageId' in payload) {
+      const message = await prisma.message.findFirst({ where: {
+        id: payload.messageId, conversationId: conversation.id, direction: 'INBOUND',
+      }, select: { id: true } });
+      if (!message || payload.isFromCustomer !== true) return { ok: false, errorCode: 'invalid_ref', errorMessage: 'Inbound message not found' };
+    }
+    const trigger = 'messageId' in payload ? {
+      messageId: payload.messageId, isFromCustomer: true, type: payload.type, hasAttachment: payload.hasAttachment,
+    } : payload;
+    const body = JSON.stringify({ organizationId, conversationId: conversation.id, contactId: payload.contactId, trigger, sentAt: new Date().toISOString() });
+    const signature = createHmac('sha256', String(params.secret)).update(body, 'utf8').digest('hex');
+    for (let attempt = 0; attempt < 3; attempt++) {
+      try {
+        const response = await fetch(String(params.url), {
+          method: 'POST', redirect: 'error', signal: AbortSignal.timeout(5000),
+          headers: { 'content-type': 'application/json', 'x-signature-256': signature }, body,
+        });
+        await response.body?.cancel();
+        if (response.ok) return { ok: true, output: { conversationId: conversation.id } };
+        if (response.status < 500 && response.status !== 429) break;
+      } catch { /* Retry only the signed, idempotent callback; never log credentials or payloads. */ }
+      if (attempt < 2) await delay(250 * (attempt + 1));
+    }
+    return { ok: false, errorCode: 'external_error', errorMessage: 'Consulta ISP did not acknowledge the webhook' };
+  }
+}
diff --git a/src/modules/automations/actions/handlers/call-webhook.handler.spec.ts b/src/modules/automations/actions/handlers/call-webhook.handler.spec.ts
new file mode 100644
index 0000000..e4a26e6
--- /dev/null
+++ b/src/modules/automations/actions/handlers/call-webhook.handler.spec.ts
@@ -0,0 +1,98 @@
+import { ConfigService } from '@nestjs/config';
+import { createHmac } from 'node:crypto';
+import { CallWebhookHandler } from './call-webhook.handler';
+import { ActionContext } from '../action.types';
+
+const url = 'https://consultaisp.com.br/api/webhooks/chat-bullq';
+const secret = 'test-webhook-secret-at-least-16';
+const payload = { organizationId: 'org', conversationId: 'conv', contactId: 'contact', channelId: 'channel', messageId: 'msg', isFromCustomer: true, type: 'AUDIO', hasAttachment: true, body: null };
+function setup() {
+  const request = jest.fn().mockResolvedValue(new Response('{}', { status: 200 }));
+  const handler = new CallWebhookHandler(new ConfigService({ CONSULTA_ISP_WEBHOOK_URL: url }));
+  const ctx = {
+    organizationId: 'org', payload,
+    prisma: { conversation: { findFirst: jest.fn().mockResolvedValue({ id: 'conv' }) }, message: { findFirst: jest.fn().mockResolvedValue({ id: 'msg' }) } },
+  } as unknown as ActionContext;
+  return { handler, request, ctx };
+}
+
+afterEach(() => jest.restoreAllMocks());
+
+const localUrl = 'http://127.0.0.1:5000/api/webhooks/chat-bullq';
+
+it('allows the configured exact loopback callback only in development', async () => {
+  const { request, ctx } = setup();
+  const handler = new CallWebhookHandler(new ConfigService({ NODE_ENV: 'development', CONSULTA_ISP_WEBHOOK_URL: localUrl }));
+  jest.spyOn(globalThis, 'fetch').mockImplementation(request);
+  expect((await handler.execute({ url: localUrl, secret }, ctx)).ok).toBe(true);
+  expect(request).toHaveBeenCalledWith(localUrl, expect.objectContaining({ method: 'POST', redirect: 'error' }));
+});
+
+it.each(['production', 'test', undefined])('rejects the configured loopback callback in %s', (environment) => {
+  const handler = new CallWebhookHandler(new ConfigService({ NODE_ENV: environment, CONSULTA_ISP_WEBHOOK_URL: localUrl }));
+  expect(() => handler.validateParams({ url: localUrl, secret })).toThrow();
+});
+
+it.each([
+  'http://localhost:5000/api/webhooks/chat-bullq',
+  'http://127.0.0.1:5001/api/webhooks/chat-bullq',
+  'http://127.0.0.1:5000/other',
+  'http://example.test/api/webhooks/chat-bullq',
+  `${localUrl}?next=1`,
+  `${localUrl}#fragment`,
+  'http://user:password@127.0.0.1:5000/api/webhooks/chat-bullq',
+])('rejects every other configured HTTP destination in development: %s', (destination) => {
+  const handler = new CallWebhookHandler(new ConfigService({ NODE_ENV: 'development', CONSULTA_ISP_WEBHOOK_URL: destination }));
+  expect(() => handler.validateParams({ url: destination, secret })).toThrow();
+});
+
+it('still requires the development loopback callback to match the server configuration', () => {
+  const handler = new CallWebhookHandler(new ConfigService({ NODE_ENV: 'development', CONSULTA_ISP_WEBHOOK_URL: url }));
+  expect(() => handler.validateParams({ url: localUrl, secret })).toThrow();
+});
+
+it.each(['development', 'production'])('allows the configured HTTPS callback in %s', (environment) => {
+  const handler = new CallWebhookHandler(new ConfigService({ NODE_ENV: environment, CONSULTA_ISP_WEBHOOK_URL: url }));
+  expect(() => handler.validateParams({ url, secret })).not.toThrow();
+});
+
+it('signs the exact webhook body, including inbound attachment identity, without exposing the secret', async () => {
+  const { handler, request, ctx } = setup();
+  jest.spyOn(globalThis, 'fetch').mockImplementation(request);
+  const result = await handler.execute({ url, secret }, ctx);
+  expect(result.ok).toBe(true);
+  const [, init] = request.mock.calls[0] as [string, RequestInit];
+  const body = String(init.body);
+  expect(JSON.parse(body)).toMatchObject({ organizationId: 'org', conversationId: 'conv', trigger: { messageId: 'msg', isFromCustomer: true } });
+  expect(init.headers).toMatchObject({ 'x-signature-256': createHmac('sha256', secret).update(body).digest('hex') });
+  expect(init.redirect).toBe('error');
+  expect(JSON.stringify(result)).not.toContain(secret);
+});
+
+it('rejects arbitrary destinations and cross-tenant events before making a request', async () => {
+  const { handler, request, ctx } = setup();
+  jest.spyOn(globalThis, 'fetch').mockImplementation(request);
+  for (const unsafe of ['http://127.0.0.1', 'https://attacker.test', `${url}?next=1`]) {
+    expect(() => handler.validateParams({ url: unsafe, secret })).toThrow();
+  }
+  expect((await handler.execute({ url, secret }, { ...ctx, organizationId: 'other' })).ok).toBe(false);
+  expect(request).not.toHaveBeenCalled();
+});
+
+it('rejects an event whose conversation does not belong to its organization', async () => {
+  const { handler, request, ctx } = setup();
+  jest.spyOn(globalThis, 'fetch').mockImplementation(request);
+  jest.mocked(ctx.prisma.conversation.findFirst).mockResolvedValueOnce(null);
+  expect((await handler.execute({ url, secret }, ctx)).ok).toBe(false);
+  expect(request).not.toHaveBeenCalled();
+});
+
+it('bounds failures to three delivery attempts and never persists a remote error body', async () => {
+  const { handler, request, ctx } = setup();
+  request.mockImplementation(async () => new Response('sensitive upstream response', { status: 503 }));
+  jest.spyOn(globalThis, 'fetch').mockImplementation(request);
+  const result = await handler.execute({ url, secret }, ctx);
+  expect(result.ok).toBe(false);
+  expect(request).toHaveBeenCalledTimes(3);
+  expect(JSON.stringify(result)).not.toContain('sensitive');
+});
diff --git a/src/modules/messaging/conversations/consulta-isp-bridge.spec.ts b/src/modules/messaging/conversations/consulta-isp-bridge.spec.ts
