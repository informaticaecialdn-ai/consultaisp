diff --git a/src/modules/platform/platform.service.ts b/src/modules/platform/platform.service.ts
new file mode 100644
index 0000000..2b70d36
--- /dev/null
+++ b/src/modules/platform/platform.service.ts
@@ -0,0 +1,89 @@
+import { BadRequestException, ConflictException, ForbiddenException, Injectable, NotFoundException } from '@nestjs/common';
+import { Prisma } from '@prisma/client';
+import { createHash, randomBytes } from 'node:crypto';
+import * as bcrypt from 'bcrypt';
+import { PrismaService } from '../../database/prisma.service';
+import { AuthService } from '../auth/auth.service';
+import { ProvisionOrganizationDto } from './platform.dto';
+
+@Injectable()
+export class PlatformService {
+  constructor(private readonly prisma: PrismaService, private readonly auth: AuthService) {}
+
+  async provision(dto: ProvisionOrganizationDto) {
+    const externalId = dto.externalId?.trim() || (dto.slug ? `slug:${dto.slug}` : '');
+    if (!externalId) throw new BadRequestException('externalId or slug is required');
+    // The existing primary key serializes competing provisions without a migration.
+    // Prefixing the identity avoids taking over an existing workspace by slug/email.
+    const digest = createHash('sha256').update(`consulta-isp:${externalId}`).digest('hex');
+    const id = `cisp_${digest}`;
+    const slug = dto.slug || `isp-${digest.slice(0, 24)}`;
+    const ownerEmail = dto.ownerEmail.trim().toLowerCase();
+    const existing = await this.prisma.organization.findUnique({ where: { id } });
+    if (existing) return this.existingProvision(id, ownerEmail);
+
+    const password = await bcrypt.hash(dto.ownerPassword ?? randomBytes(32).toString('base64url'), 12);
+    try {
+      await this.prisma.$transaction(async (tx) => {
+        if (await tx.user.findUnique({ where: { email: ownerEmail } })) {
+          throw new ConflictException('Owner email already belongs to an account; use a dedicated address');
+        }
+        const user = await tx.user.create({ data: { name: dto.ownerName, email: ownerEmail, password } });
+        await tx.organization.create({ data: {
+          id, name: dto.name, slug,
+          settings: { consultaIsp: { externalId, ownerUserId: user.id } },
+          members: { create: { userId: user.id, role: 'OWNER' } },
+        } });
+        const membership = await tx.userOrganization.findUniqueOrThrow({ where: { userId_organizationId: { userId: user.id, organizationId: id } } });
+        await tx.department.create({ data: {
+          organizationId: id, name: 'Geral', isDefault: true,
+          agents: { create: { userOrganizationId: membership.id } },
+        } });
+      });
+    } catch (error) {
+      // Only a concurrent provision of the same identity can turn into success.
+      // Slug/email collisions with unrelated workspaces remain conflicts.
+      if ((error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') || error instanceof ConflictException) {
+        const concurrent = await this.prisma.organization.findUnique({ where: { id } });
+        if (concurrent) return this.existingProvision(id, ownerEmail);
+        throw new ConflictException('Organization slug or owner email is already in use');
+      }
+      throw error;
+    }
+    return { ...(await this.existingProvision(id, ownerEmail)), created: true };
+  }
+
+  private async existingProvision(id: string, expectedEmail: string) {
+    const { organization, owner } = await this.managedOwner(id);
+    if (owner.email.toLowerCase() !== expectedEmail) throw new ConflictException('Organization identity belongs to another owner');
+    return { organizationId: id, slug: organization.slug, ownerUserId: owner.id, ownerEmail: owner.email, created: false };
+  }
+
+  private async managedOwner(id: string) {
+    const organization = await this.prisma.organization.findUnique({ where: { id } });
+    if (!organization || organization.deletedAt) throw new NotFoundException('Managed organization not found');
+    const settings = organization.settings;
+    const metadata = settings && typeof settings === 'object' && !Array.isArray(settings) ? settings.consultaIsp : null;
+    if (!metadata || typeof metadata !== 'object' || Array.isArray(metadata) || typeof metadata.ownerUserId !== 'string' || typeof metadata.externalId !== 'string') {
+      throw new ForbiddenException('Organization is not managed by this bridge');
+    }
+    const membership = await this.prisma.userOrganization.findFirst({
+      where: { organizationId: id, userId: metadata.ownerUserId, role: 'OWNER' }, include: { user: true },
+    });
+    if (!membership?.user.isActive || await this.prisma.userOrganization.count({ where: { userId: metadata.ownerUserId } }) !== 1) {
+      throw new ForbiddenException('Bridge owner must be active and exclusive to this organization');
+    }
+    return { organization, owner: membership.user };
+  }
+
+  async tokens(id: string) {
+    const { owner } = await this.managedOwner(id);
+    return this.auth.issueTokensForUser(owner.id);
+  }
+
+  async ownerPassword(id: string, password: string) {
+    const { owner } = await this.managedOwner(id);
+    await this.prisma.user.update({ where: { id: owner.id }, data: { password: await bcrypt.hash(password, 12) } });
+    return { ownerUserId: owner.id, ownerEmail: owner.email };
+  }
+}
