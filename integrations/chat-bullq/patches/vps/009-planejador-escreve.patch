+  /\bopen\s?ai\b/i,
+  /\bmodelo\s+de\s+linguagem\b/i,
+  /\bplanejador\b/i,
+  /\berp\b/i,
+  /\binstru[çc](?:[ãa]o|[õo]es)\s+(?:do\s+sistema|intern[ao]s?|que\s+recebi)\b/i,
+  /\b(?:allowedActions|operation|history|context)\b/,
