-/** Valida o que o motor externo vai ler; o resto do que o modelo escreveu não passa daqui. */
-export function parsePlan(raw: unknown, allowed: Action[]): AutonomousPlan {
+/**
+ * 009 — o que nunca vai ao cliente, conferido AQUI antes de o Consulta ISP
