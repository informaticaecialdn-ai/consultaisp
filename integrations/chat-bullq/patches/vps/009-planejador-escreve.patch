+  /\bn[ãa]o\s+(?:vou\s+)?(?:seguir|obedecer)\s+(?:ess[ae]|a)\s+instru[çc][ãa]o/i,
+  /\bess[ae]\s+(?:mensagem|instru[çc][ãa]o)\s+n[ãa]o\s+veio\s+do\s+cliente/i,
+  /\b(?:detectei|identifiquei)\s+(?:uma\s+)?tentativa\s+de\s+(?:prompt\s+)?inje[çc][ãa]o/i,
