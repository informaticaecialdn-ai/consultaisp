+/**
+ * As mensagens que a IA escreveu, se TODAS passarem; senão `null`. Tudo ou nada:
+ * enviar dois balões de três pode mudar o sentido (o que caiu podia ser a
+ * pergunta), e sem mensagens o Consulta ISP usa o texto de reserva dele.
+ */
+export function mensagensSeguras(value: unknown): string[] | null {
+  if (!Array.isArray(value) || value.length < 1 || value.length > MENSAGENS_MAX) return null;
+  const mensagens: string[] = [];
+  let total = 0;
+  for (const item of value) {
+    if (typeof item !== 'string') return null;
+    const mensagem = item.trim();
+    if (!mensagem.length || mensagem.length > MENSAGEM_MAX_CARACTERES) return null;
+    if (TEXTO_PROIBIDO_NA_MENSAGEM.some(re => re.test(mensagem))) return null;
+    total += mensagem.length;
+    mensagens.push(mensagem);
+  }
+  return total <= MENSAGENS_MAX_CARACTERES ? mensagens : null;
+}
+/**
+ * Valida o que o motor externo vai ler; o resto do que o modelo escreveu não passa daqui.
+ * Com `escrever` (009) o texto é o produto, e vale a lição do 008: descartar é
+ * mais seguro do que recusar. Mensagem que falha vai embora e o plano segue (o
+ * Consulta ISP usa a reserva); `resposta` ausente ou fora do catálogo vira
+ * `acolher`, a reserva mais neutra. Continua recusado só o que é DECISÃO: ação,
+ * data, valor e fatura. Sem `escrever` nada disso roda — `mensagens` nem é lida
+ * e a saída é a do 008, que o Consulta ISP antigo (schema `.strict()`) aceita.
+ */
+export function parsePlan(raw: unknown, allowed: Action[], escrever = false): AutonomousPlan {
   const bad = () => new ServiceUnavailableException('A IA não produziu um plano válido');
   if (!object(raw) || typeof raw.acao !== 'string' || !allowed.includes(raw.acao as Action)) throw bad();
   const acao = raw.acao as Action;
   const plan: Record<string, unknown> = {};
-  for (const key of CAMPOS[acao]) if (raw[key] !== undefined && raw[key] !== null) plan[key] = raw[key];
+  for (const key of CAMPOS[acao]) if ((escrever || key !== 'mensagens') && raw[key] !== undefined && raw[key] !== null) plan[key] = raw[key];
   if (plan.motivo !== undefined && !text(plan.motivo, 300)) delete plan.motivo;
-  if (acao === 'responder' && !REPLIES.includes(plan.resposta as typeof REPLIES[number])) throw bad();
+  if (acao === 'responder' && !REPLIES.includes(plan.resposta as typeof REPLIES[number])) {
+    if (!escrever) throw bad();
+    plan.resposta = 'acolher';
+  }
+  if (plan.mensagens !== undefined) {
+    const mensagens = mensagensSeguras(plan.mensagens);
+    if (mensagens) plan.mensagens = mensagens; else delete plan.mensagens;
+  }
   const data = plan.data;
   if (acao === 'promessa') {
     if (!text(data, 35) || !/^\d{4}-\d{2}-\d{2}$/.test(data) || !Number.isFinite(Date.parse(data)) || new Date(data).toISOString().slice(0, 10) !== data) throw bad();
