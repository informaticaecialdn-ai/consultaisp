+import 'reflect-metadata';
+import {
+  BadRequestException,
+  ConflictException,
+  ForbiddenException,
+  Logger,
+  NotFoundException,
+  RequestMethod,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { GUARDS_METADATA, METHOD_METADATA, PATH_METADATA } from '@nestjs/common/constants';
+import { MessageStatus, OrgRole } from '@prisma/client';
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { JwtAuthGuard, OrgGuard, RolesGuard } from '../../../common/guards';
+import { ROLES_KEY } from '../../../common/decorators';
+import { LoteDoAgenteDto } from './dto/lote-do-agente.dto';
+import { LoteDoAgenteService } from './lote-do-agente.service';
+import { MessagesController } from './messages.controller';
+import { LOTE_DO_AGENTE_JOB } from '../pipeline/lote-do-agente';
+
+const AGENTE = {
+  id: 'ag1', name: 'Clara', capabilities: ['autonomia_cobranca_controlada'], isActive: false, canRespondDirectly: false,
+};
+const CONVERSA = {
+  id: 'cv1', organizationId: 'org-a', channelId: 'ch1', contactId: 'ct1', assignedToId: 'owner', deletedAt: null,
+  aiEnabled: false, status: 'BOT',
+  contact: { channels: [{ channelId: 'ch1', externalId: '554391191100@s.whatsapp.net' }] },
+};
+
+function fixture(o: { conversa?: unknown; agente?: unknown; filaFalha?: boolean } = {}) {
+  let n = 0;
+  const criadas: any[] = [];
+  const prisma = {
+    conversation: {
+      findUnique: jest.fn().mockResolvedValue('conversa' in o ? o.conversa : CONVERSA),
+      update: jest.fn().mockResolvedValue({}),
+    },
+    aiAgent: { findFirst: jest.fn().mockResolvedValue('agente' in o ? o.agente : AGENTE) },
+    message: {
+      create: jest.fn(async ({ data }: any) => {
+        const m = { id: `m${++n}`, ...data };
+        criadas.push(m);
+        return m;
+      }),
+      updateMany: jest.fn().mockResolvedValue({ count: 0 }),
+    },
+    $transaction: jest.fn((ops: Promise<unknown>[]) => Promise.all(ops)),
+  };
+  const realtime = { emitToChannel: jest.fn(), emitToConversation: jest.fn() };
+  const channelAccess = { assertChannelAccess: jest.fn() };
+  const queue = {
+    add: o.filaFalha ? jest.fn().mockRejectedValue(new Error('redis fora')) : jest.fn().mockResolvedValue({ id: 'j1' }),
+  };
+  const service = new LoteDoAgenteService(prisma as never, realtime as never, channelAccess as never, queue as never);
+  return { service, prisma, realtime, channelAccess, queue, criadas };
+}
+
+const dto = (textos: unknown = ['Oi, Maria!', 'Vi aqui a sua conta de setembro.']) =>
+  ({ conversationId: 'cv1', aiAgentId: 'ag1', textos }) as LoteDoAgenteDto;
+
+describe('POST /messages/agent-batch — guardas e formato', () => {
+  it('controller: JWT + organização + papel; a rota exige OWNER/ADMIN', () => {
+    expect(Reflect.getMetadata(GUARDS_METADATA, MessagesController)).toEqual([JwtAuthGuard, OrgGuard, RolesGuard]);
+    const handler = MessagesController.prototype.sendAgentBatch;
+    expect(Reflect.getMetadata(ROLES_KEY, handler)).toEqual([OrgRole.OWNER, OrgRole.ADMIN]);
+    expect(Reflect.getMetadata(PATH_METADATA, handler)).toBe('agent-batch');
+    expect(Reflect.getMetadata(METHOD_METADATA, handler)).toBe(RequestMethod.POST);
+    // O envio comum continua aberto a qualquer membro, como antes.
+    expect(Reflect.getMetadata(ROLES_KEY, MessagesController.prototype.send)).toBeUndefined();
+  });
+
+  it('controller repassa usuário, organização e acesso ao serviço', async () => {
+    const lote = { enviar: jest.fn().mockResolvedValue({ loteId: 'l1', mensagens: [] }) };
+    const controller = new MessagesController({} as never, {} as never, {} as never, {} as never, lote as never);
+    await controller.sendAgentBatch(dto(), 'owner', 'org-a', 'ALL');
+    expect(lote.enviar).toHaveBeenCalledWith(dto(), 'owner', 'org-a', 'ALL');
+  });
+
+  const erros = async (corpo: unknown) =>
+    validate(plainToInstance(LoteDoAgenteDto, corpo), { whitelist: true, forbidNonWhitelisted: true });
+
+  it('DTO: 1 a 4 textos, string, até 4000 caracteres, sem campo extra', async () => {
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: ['a'] })).toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: ['a', 'b', 'c', 'd'] })).toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: [] })).not.toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: ['a', 'b', 'c', 'd', 'e'] })).not.toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: [1] })).not.toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: ['x'.repeat(4001)] })).not.toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: 'oi' })).not.toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', textos: ['a'] })).not.toHaveLength(0);
+    expect(await erros({ conversationId: 'cv1', aiAgentId: 'ag1', textos: ['a'], assinatura: true })).not.toHaveLength(0);
+  });
+});
+
+describe('lote do agente — aceitar e enfileirar', () => {
+  beforeEach(() => {
+    jest.spyOn(Logger.prototype, 'log').mockImplementation(() => undefined);
+    jest.spyOn(Logger.prototype, 'warn').mockImplementation(() => undefined);
+    jest.spyOn(Logger.prototype, 'error').mockImplementation(() => undefined);
+  });
+  afterEach(() => jest.restoreAllMocks());
+
+  it('cria as mensagens como o agente: nome, aiAgentId, autor real, sem senderId, em ordem de createdAt', async () => {
+    const f = fixture();
+    const r = await f.service.enviar(dto(), 'owner', 'org-a');
+    expect(r.mensagens).toEqual([{ id: 'm1', status: MessageStatus.QUEUED }, { id: 'm2', status: MessageStatus.QUEUED }]);
+    expect(r.loteId).toMatch(/^[0-9a-f-]{36}$/);
+    expect(f.prisma.$transaction).toHaveBeenCalledTimes(1);
+    const [a, b] = f.criadas;
+    for (const [m, indice, texto] of [[a, 0, 'Oi, Maria!'], [b, 1, 'Vi aqui a sua conta de setembro.']] as const) {
+      expect(m).toEqual(expect.objectContaining({
+        conversationId: 'cv1', direction: 'OUTBOUND', type: 'TEXT', status: MessageStatus.QUEUED,
+        content: { text: texto }, senderName: 'Clara',
+        metadata: { aiAgentId: 'ag1', enviadoPorUserId: 'owner', lote: { id: r.loteId, indice, total: 2 } },
+      }));
+      expect(m.senderId).toBeUndefined();
+    }
+    expect(b.createdAt.getTime()).toBe(a.createdAt.getTime() + 1);
+    // Sem assinatura: o texto vai como veio.
+    expect(a.content.text.startsWith('*')).toBe(false);
+  });
+
+  it('não atribui, não pausa a IA, não marca lida: só lastMessageAt', async () => {
+    const f = fixture();
+    await f.service.enviar(dto(), 'owner', 'org-a');
+    expect(f.prisma.conversation.update).toHaveBeenCalledTimes(1);
+    const { data } = f.prisma.conversation.update.mock.calls[0][0];
+    expect(Object.keys(data)).toEqual(['lastMessageAt']);
+    expect((f.prisma as any).conversationRead).toBeUndefined();
+  });
+
+  it('UM job de lote, sem repetição automática, com os balões na ordem pedida', async () => {
+    const f = fixture();
+    const inicio = Date.now();
+    await f.service.enviar(dto(['um', 'dois', 'três']), 'owner', 'org-a');
+    expect(f.queue.add).toHaveBeenCalledTimes(1);
+    const [nome, job, opts] = f.queue.add.mock.calls[0];
+    expect(nome).toBe(LOTE_DO_AGENTE_JOB);
