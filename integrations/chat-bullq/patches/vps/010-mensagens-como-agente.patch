+import { ArrayMaxSize, ArrayMinSize, IsArray, IsNotEmpty, IsString, MaxLength } from 'class-validator';
+import { ApiProperty } from '@nestjs/swagger';
+import { LOTE_MAX_CARACTERES, LOTE_MAX_MENSAGENS } from '../../pipeline/lote-do-agente';
+
+/** `POST /messages/agent-batch`: os balões de UM turno do agente, na ordem em que o cliente deve lê-los. */
+export class LoteDoAgenteDto {
+  @ApiProperty({ example: 'conversation-id-here' })
+  @IsString()
+  @IsNotEmpty()
+  @MaxLength(64)
+  conversationId: string;
+
+  @ApiProperty({ example: 'ai-agent-id-here' })
+  @IsString()
+  @IsNotEmpty()
+  @MaxLength(64)
+  aiAgentId: string;
+
+  @ApiProperty({ example: ['Oi, Maria!', 'Vi aqui a sua fatura de setembro.'], minItems: 1, maxItems: LOTE_MAX_MENSAGENS })
+  @IsArray()
+  @ArrayMinSize(1)
+  @ArrayMaxSize(LOTE_MAX_MENSAGENS)
+  @IsString({ each: true })
+  @MaxLength(LOTE_MAX_CARACTERES, { each: true })
+  textos: string[];
+}
