@@ -0,0 +1,42 @@
+import { digitandoMs, motivoParaParar, RAZAO_DA_PARADA } from './lote-do-agente';
+
+describe('lote do agente: regras puras', () => {
+  it('"digitando…" = 800 ms + 35 ms por caractere, teto de 4 s', () => {
+    expect(digitandoMs('')).toBe(800);
+    expect(digitandoMs('Oi, Maria!')).toBe(800 + 35 * 10);
+    expect(digitandoMs('x'.repeat(91))).toBe(3985);
+    expect(digitandoMs('x'.repeat(92))).toBe(4000);
+    expect(digitandoMs('x'.repeat(4000))).toBe(4000);
+  });
+
+  const lote = { enviadoPorUserId: 'owner', criadoEm: Date.parse('2026-09-16T12:00:00.000Z') };
+  const conversa = (c: Partial<{ assignedToId: string | null; aiDisabledAt: Date | null; deletedAt: Date | null }> = {}) => ({
+    assignedToId: null, aiDisabledAt: null, deletedAt: null, ...c,
+  });
+
+  it('segue quando a conversa não tem dono ou é de quem pediu o lote', () => {
+    expect(motivoParaParar(conversa(), lote)).toBeNull();
+    // O envio antigo do Consulta ISP atribuía a conversa ao OWNER do token.
+    expect(motivoParaParar(conversa({ assignedToId: 'owner' }), lote)).toBeNull();
+  });
+
+  it('para quando um OUTRO usuário assumiu', () => {
+    expect(motivoParaParar(conversa({ assignedToId: 'atendente' }), lote)).toBe('conversa_com_humano');
+  });
+
+  it('para quando a IA foi desligada DEPOIS do lote (assumir/transferir pelo Consulta ISP usa o mesmo token)', () => {
+    expect(motivoParaParar(conversa({ assignedToId: 'owner', aiDisabledAt: new Date(lote.criadoEm + 1) }), lote)).toBe('conversa_com_humano');
+    // Desligada antes (o envio antigo pausava a IA; o aviso de transferência sai depois do desligar): não para.
+    expect(motivoParaParar(conversa({ aiDisabledAt: new Date(lote.criadoEm - 60_000) }), lote)).toBeNull();
+    expect(motivoParaParar(conversa({ aiDisabledAt: new Date(lote.criadoEm) }), lote)).toBeNull();
+  });
+
+  it('para quando a conversa sumiu', () => {
+    expect(motivoParaParar(null, lote)).toBe('conversa_indisponivel');
+    expect(motivoParaParar(conversa({ deletedAt: new Date() }), lote)).toBe('conversa_indisponivel');
+  });
+
+  it('todo motivo tem texto legível para o inbox', () => {
+    for (const texto of Object.values(RAZAO_DA_PARADA)) expect(texto.length).toBeGreaterThan(10);
+  });
+});
diff --git a/src/modules/messaging/pipeline/lote-do-agente.ts b/src/modules/messaging/pipeline/lote-do-agente.ts
new file mode 100644
index 0000000..cfc6f2d
--- /dev/null
+++ b/src/modules/messaging/pipeline/lote-do-agente.ts
@@ -0,0 +1,82 @@
+/**
+ * Lote de mensagens de um agente de autonomia controlada (Consulta ISP).
+ *
+ * Existe porque `POST /messages` fala como o USUÁRIO do token: assina o texto
+ * com o nome dele ("*NsLink Provedor*"), atribui a conversa a ele, pausa a IA e
+ * não mostra "digitando…". E porque a fila `outbound-messages` roda com
+ * concorrência 5: dois balões enfileirados em sequência podem chegar trocados
+ * no WhatsApp. O lote vira UM job que envia os balões em ordem, cada um depois
+ * do "digitando…", e para quando a conversa muda de mãos.
+ */
+
+/** Nome do job na fila `outbound-messages` (o processor distingue pelo nome). */
+export const LOTE_DO_AGENTE_JOB = 'send-agent-batch';
+
+/** A capability que o planejador do Consulta ISP já exige (autonomous-plan.service). */
+export const CAPABILITY_DO_LOTE = 'autonomia_cobranca_controlada';
+
+export const LOTE_MAX_MENSAGENS = 4;
+/** O mesmo teto da tool `replyToConversation`: o balão do servidor (PIX, linha digitável) passa dos 600 do planejador. */
+export const LOTE_MAX_CARACTERES = 4000;
+
+export interface LoteDoAgenteJob {
+  loteId: string;
+  conversationId: string;
+  channelId: string;
+  contactExternalId: string;
+  aiAgentId: string;
+  /** Quem chamou o endpoint: é o dono do token, não um atendente assumindo. */
+  enviadoPorUserId: string;
+  /** Epoch ms de quando o lote foi aceito — o batente de "a IA foi desligada depois". */
+  criadoEm: number;
+  mensagens: { messageId: string; texto: string }[];
+}
+
+export type MotivoDaParada =
+  | 'conversa_com_humano'
+  | 'conversa_indisponivel'
+  | 'envio_incerto'
+  | 'balao_anterior_nao_saiu';
+
+/** Texto de `failedReason` (o inbox mostra); o código vai em `metadata.loteInterrompido`. */
+export const RAZAO_DA_PARADA: Record<MotivoDaParada, string> = {
+  conversa_com_humano: 'Não enviada: a conversa passou para um atendente.',
+  conversa_indisponivel: 'Não enviada: a conversa não está mais disponível.',
+  envio_incerto: 'Envio incerto: o envio foi interrompido e não é repetido.',
+  balao_anterior_nao_saiu: 'Não enviada: a mensagem anterior do lote não saiu.',
+};
+
+/**
+ * "Digitando…" de um balão: 800 ms + 35 ms por caractere, no máximo 4 s.
+ * Só o lote usa esta conta; as mensagens da IA do próprio fork seguem com a do
+ * `simulateTypingIfAiMessage` (900 ms + 28 ms, 1–6 s), para não mudar o ritmo
+ * das outras organizações.
+ */
+export function digitandoMs(texto: string): number {
+  return Math.min(4000, 800 + 35 * texto.length);
+}
+
+/**
+ * Por que o lote não deve mandar o próximo balão — `null` quando pode.
+ *
+ * A conversa "mudou de mãos" quando:
+ *  - foi atribuída a um usuário que não é quem pediu o lote (um atendente
+ *    respondeu pelo inbox: `send()` atribui a quem responde); ou
+ *  - a IA da conversa foi desligada DEPOIS de o lote ser aceito. É o gesto de
+ *    "assumir" e de "transferir" do Consulta ISP (`PATCH /conversations/:id/ai`
+ *    com `enabled:false`), do botão do inbox e da transferência pendente — todo
+ *    lugar que grava `aiDisabledAt`. O token do Consulta ISP é o mesmo usuário
+ *    nos dois casos, então só o `assignedToId` não enxergaria o operador de lá.
+ *
+ * O `status` NÃO entra: o próprio fork troca WAITING → OPEN quando o cliente
+ * responde (`touchOpen`), e o lote pararia por uma resposta do cliente.
+ */
+export function motivoParaParar(
+  conversa: { assignedToId: string | null; aiDisabledAt: Date | null; deletedAt: Date | null } | null,
+  lote: Pick<LoteDoAgenteJob, 'enviadoPorUserId' | 'criadoEm'>,
+): MotivoDaParada | null {
+  if (!conversa || conversa.deletedAt) return 'conversa_indisponivel';
+  if (conversa.assignedToId && conversa.assignedToId !== lote.enviadoPorUserId) return 'conversa_com_humano';
+  if (conversa.aiDisabledAt && conversa.aiDisabledAt.getTime() > lote.criadoEm) return 'conversa_com_humano';
+  return null;
+}
