diff --git a/src/modules/messaging/messages/lote-do-agente.service.ts b/src/modules/messaging/messages/lote-do-agente.service.ts
new file mode 100644
index 0000000..ab7ba86
--- /dev/null
+++ b/src/modules/messaging/messages/lote-do-agente.service.ts
@@ -0,0 +1,187 @@
+import {
+  BadRequestException,
+  ConflictException,
+  ForbiddenException,
+  Injectable,
+  Logger,
+  NotFoundException,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import { InjectQueue } from '@nestjs/bullmq';
+import { Queue } from 'bullmq';
+import { MessageContentType, MessageDirection, MessageStatus } from '@prisma/client';
+import { randomUUID } from 'node:crypto';
+import { PrismaService } from '../../../database/prisma.service';
+import { RealtimeGateway } from '../../realtime/realtime.gateway';
+import { ChannelAccess, ChannelAccessService } from '../../iam/channel-access/channel-access.service';
+import { containsMetaTalk } from '../../ai-agents/runner/text-guards';
+import { LoteDoAgenteDto } from './dto/lote-do-agente.dto';
+import {
+  CAPABILITY_DO_LOTE,
+  LOTE_DO_AGENTE_JOB,
+  LOTE_MAX_CARACTERES,
+  LOTE_MAX_MENSAGENS,
+  LoteDoAgenteJob,
+} from '../pipeline/lote-do-agente';
+
+export interface LoteAceito {
+  loteId: string;
+  mensagens: { id: string; status: MessageStatus }[];
+}
+
+/**
+ * Mensagens escritas por um agente de autonomia controlada e enviadas pelo
+ * Consulta ISP. Faz o que a tool `replyToConversation` faz com a mensagem da IA
+ * — `senderName` do agente, `metadata.aiAgentId`, SEM assinatura, SEM pausar a
+ * IA, SEM atribuir, SEM marcar lida, e o guard de meta-talk — e acrescenta o que
+ * a tool não precisa: o autor real em `metadata.enviadoPorUserId` (quem tem o
+ * token fala como a persona, mas fica o rastro) e a ORDEM entre balões.
+ *
+ * Só o agente que o planejador aceita (capability de autonomia, parado, sem
+ * resposta direta) pode ser o remetente: um agente ativo nos canais responderia
+ * por conta própria e disputaria a conversa com o lote.
+ */
+@Injectable()
+export class LoteDoAgenteService {
+  private readonly logger = new Logger(LoteDoAgenteService.name);
+
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly realtimeGateway: RealtimeGateway,
+    private readonly channelAccess: ChannelAccessService,
+    @InjectQueue('outbound-messages') private readonly outboundQueue: Queue,
+  ) {}
+
+  async enviar(
+    dto: LoteDoAgenteDto,
+    userId: string,
+    organizationId: string,
+    access: ChannelAccess = 'ALL',
+  ): Promise<LoteAceito> {
+    // O ValidationPipe já barra o formato; aqui é a regra, para quem chamar o
+    // serviço sem o pipe. Texto em branco não vira balão vazio.
+    const textos = Array.isArray(dto.textos) ? dto.textos.map((t) => (typeof t === 'string' ? t.trim() : '')) : [];
+    if (
+      textos.length < 1 ||
+      textos.length > LOTE_MAX_MENSAGENS ||
+      textos.some((t) => !t || t.length > LOTE_MAX_CARACTERES)
+    ) {
+      throw new BadRequestException(
+        `Envie de 1 a ${LOTE_MAX_MENSAGENS} mensagens de texto, cada uma com até ${LOTE_MAX_CARACTERES} caracteres.`,
+      );
+    }
+
+    const conversation = await this.prisma.conversation.findUnique({
+      where: { id: dto.conversationId },
+      include: { contact: { include: { channels: true } } },
+    });
+    if (!conversation || conversation.deletedAt) throw new NotFoundException('Conversa não encontrada');
+    if (conversation.organizationId !== organizationId) throw new ForbiddenException();
+    this.channelAccess.assertChannelAccess(access, conversation.channelId);
+
+    const agent = await this.prisma.aiAgent.findFirst({
+      where: { id: dto.aiAgentId, organizationId, deletedAt: null },
+      select: { id: true, name: true, capabilities: true, isActive: true, canRespondDirectly: true },
+    });
+    if (!agent) throw new NotFoundException('Agente não encontrado nesta organização');
+    if (!agent.capabilities.includes(CAPABILITY_DO_LOTE) || agent.isActive || agent.canRespondDirectly) {
+      this.recusa('agente_nao_controlado', dto);
+      throw new BadRequestException('Configure um agente de autonomia controlada sem resposta direta nos canais');
+    }
+
+    // Quem chama é o dono do token (o Consulta ISP usa o OWNER, a quem o envio
+    // antigo atribuía a conversa); qualquer OUTRO usuário é um atendente.
+    if (conversation.assignedToId && conversation.assignedToId !== userId) {
+      this.recusa('conversa_com_humano', dto);
+      throw new ConflictException('A conversa está com um atendente; o agente não envia por cima.');
+    }
+
+    if (textos.some((t) => containsMetaTalk(t))) {
+      this.recusa('meta_talk', dto);
+      throw new BadRequestException(
+        'Mensagem recusada: descreve raciocínio interno da IA em vez de responder ao cliente.',
+      );
+    }
+
+    const contactChannel = conversation.contact.channels.find((cc) => cc.channelId === conversation.channelId);
+    if (!contactChannel) throw new NotFoundException('Contact channel not found');
+
+    const loteId = randomUUID();
+    const criadoEm = Date.now();
+    const total = textos.length;
+    // `createdAt` explícito e crescente: a timeline ordena por ele, e creates do
+    // mesmo milissegundo deixariam a ordem dos balões no inbox ao acaso.
+    const mensagens = await this.prisma.$transaction(
+      textos.map((texto, indice) =>
+        this.prisma.message.create({
+          data: {
+            conversationId: conversation.id,
+            direction: MessageDirection.OUTBOUND,
+            type: MessageContentType.TEXT,
+            content: { text: texto },
+            status: MessageStatus.QUEUED,
+            senderName: agent.name,
+            createdAt: new Date(criadoEm + indice),
+            metadata: {
+              aiAgentId: agent.id,
+              enviadoPorUserId: userId,
+              lote: { id: loteId, indice, total },
+            },
+          },
+        }),
+      ),
+    );
+
+    await this.prisma.conversation.update({
+      where: { id: conversation.id },
+      data: { lastMessageAt: new Date() },
+    });
+
+    for (const message of mensagens) {
+      this.realtimeGateway.emitToChannel(conversation.channelId, 'message:new', {
+        message,
+        conversationId: conversation.id,
+        contactId: conversation.contactId,
+      });
+      this.realtimeGateway.emitToConversation(conversation.id, 'message:new', { message });
+    }
+
+    const job: LoteDoAgenteJob = {
+      loteId,
+      conversationId: conversation.id,
+      channelId: conversation.channelId,
+      contactExternalId: contactChannel.externalId,
+      aiAgentId: agent.id,
+      enviadoPorUserId: userId,
+      criadoEm,
+      mensagens: mensagens.map((m, i) => ({ messageId: m.id, texto: textos[i] })),
+    };
+    try {
+      // UM job para o lote inteiro: a fila roda 5 em paralelo, e só um job
+      // sequencial garante a ordem. `attempts: 1` porque repetir o lote
+      // reenviaria balão que já saiu — falha vira "não enviada", nunca reenvio.
+      await this.outboundQueue.add(LOTE_DO_AGENTE_JOB, job, {
+        attempts: 1,
+        removeOnComplete: true,
+        removeOnFail: false,
+      });
+    } catch (err: any) {
+      await this.prisma.message.updateMany({
+        where: { id: { in: mensagens.map((m) => m.id) }, status: MessageStatus.QUEUED },
+        data: { status: MessageStatus.FAILED, failedReason: 'Não enviada: a fila de envio não aceitou o lote.' },
+      });
+      this.logger.error(`Lote ${loteId} não entrou na fila: ${err?.message ?? err}`);
+      throw new ServiceUnavailableException('Fila de envio indisponível; nenhuma mensagem do lote saiu.');
+    }
+
+    this.logger.log(
+      `Lote ${loteId} do agente ${agent.id} na conversa ${conversation.id}: ${total} mensagem(ns) na fila`,
+    );
+    return { loteId, mensagens: mensagens.map((m) => ({ id: m.id, status: m.status })) };
+  }
+
+  /** Só ids e o código: nunca texto, telefone ou nome. */
+  private recusa(codigo: string, dto: LoteDoAgenteDto) {
+    this.logger.warn(`Lote recusado (${codigo}): agente=${dto.aiAgentId} conversa=${dto.conversationId}`);
+  }
+}
