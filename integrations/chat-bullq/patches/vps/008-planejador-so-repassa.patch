 =?UTF-8?q?ia=20so=20repassa=20o=20que=20o=20Consulta=20ISP=20le=20?=
 =?UTF-8?q?=E2=80=94=20texto,=20valor=20e=20fatura=20fora=20da=20acao=20sa?=
 =?UTF-8?q?o=20descartados,=20nao=20recusados=20(5=20de=206=20planos=20de?=
 =?UTF-8?q?=20responder=20do=20gpt-4o=20vinham=20assim=20e=20toda=20conver?=
 =?UTF-8?q?sa=20ia=20ao=20atendente)?=
