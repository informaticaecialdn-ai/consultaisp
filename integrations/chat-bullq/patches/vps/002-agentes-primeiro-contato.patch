diff --git a/src/modules/ai-agents/llm/first-contact-models.ts b/src/modules/ai-agents/llm/first-contact-models.ts
new file mode 100644
index 0000000..035515c
--- /dev/null
+++ b/src/modules/ai-agents/llm/first-contact-models.ts
@@ -0,0 +1,149 @@
+import { ServiceUnavailableException } from '@nestjs/common';
+import type OpenAI from 'openai';
+import { LlmProvider, resolveLlmModel } from './llm.constants';
+
+/**
+ * Catálogo real das credenciais configuradas, sem catálogo estático e sem
+ * substituição de modelo.
+ *
+ * Esta é a versão multi-provider: este deploy fala com Sakana e OpenAI, e o
+ * cliente de cada provedor só existe quando a chave dele está no ambiente.
+ * O catálogo pergunta a cada cliente vivo o que a credencial oferece e
+ * devolve os IDs já prefixados (`sakana/...`, `openai/...`), no mesmo
+ * formato em que `AiAgent.modelId` é gravado.
+ */
+export type ModelClients = Partial<
+  Record<LlmProvider, Pick<OpenAI, 'models'> | null>
+>;
+
+export interface FirstContactCatalog {
+  configured: boolean;
+  models: { id: string }[];
+  /** Provedores configurados cuja listagem falhou agora. */
+  indisponiveis: LlmProvider[];
+}
+
+/**
+ * Só entra no catálogo o ID que o próprio resolvedor deste deploy aceita como
+ * modelo de agente (`fugu`, `fugu-*` na Sakana; `gpt-*` na OpenAI). É o mesmo
+ * critério de `resolveLlmModel`, então o catálogo nunca oferece um modelo que
+ * o `complete()` recusaria — e embedding, tts, whisper e dall-e ficam de fora.
+ */
+export function catalogId(
+  provider: LlmProvider,
+  rawId: string,
+): string | null {
+  const bare = rawId.startsWith(`${provider}/`)
+    ? rawId.slice(provider.length + 1)
+    : rawId;
+  const resolved = resolveLlmModel(bare);
+  if (!resolved || resolved.provider !== provider) return null;
+  return `${provider}/${resolved.model}`;
+}
+
+/** Provedor do modelo gravado no agente; null quando o ID não é suportado. */
+export function providerOf(modelId: string): LlmProvider | null {
+  return resolveLlmModel(modelId)?.provider ?? null;
+}
+
+/** Compara dois IDs de modelo ignorando a forma (com ou sem prefixo). */
+export function sameModel(a: string, b: string): boolean {
+  const ra = resolveLlmModel(a);
+  const rb = resolveLlmModel(b);
+  if (!ra || !rb) return false;
+  return ra.provider === rb.provider && ra.model === rb.model;
+}
+
+/**
+ * Sufixo de data que os provedores acrescentam ao ID base quando devolvem o
+ * snapshot que realmente atendeu (`gpt-4o-mini` → `gpt-4o-mini-2024-07-18`).
+ * É a mesma tolerância que `llm-pricing.ts` já usa para cobrar o preço do
+ * modelo base. Nada além de uma data passa: `fugu` continua diferente de
+ * `fugu-ultra-20260615`, então a trava contra troca de modelo permanece.
+ */
+const VERSION_SUFFIX = /^-\d{4}-\d{2}-\d{2}$|^-\d{8}$/;
+
+/** O provedor respondeu com o modelo pedido (ou o snapshot datado dele)? */
+export function answeredWithSameModel(
+  requested: string,
+  returned: string,
+): boolean {
+  const req = resolveLlmModel(requested);
+  if (!req) return false;
+  const raw = (returned ?? '').trim();
+  const bare = raw.startsWith(`${req.provider}/`)
+    ? raw.slice(req.provider.length + 1)
+    : raw;
+  if (bare === req.model) return true;
+  return (
+    bare.startsWith(req.model) && VERSION_SUFFIX.test(bare.slice(req.model.length))
+  );
+}
+
+export class FirstContactModels {
+  private cached?: { expiresAt: number; catalog: FirstContactCatalog };
+  private loading?: Promise<FirstContactCatalog>;
+
+  constructor(private readonly clients: ModelClients) {}
+
+  private get providers(): LlmProvider[] {
+    return (Object.keys(this.clients) as LlmProvider[]).filter(
+      (p) => !!this.clients[p],
+    );
+  }
+
+  async list(): Promise<FirstContactCatalog> {
+    const providers = this.providers;
+    if (providers.length === 0) {
+      return { configured: false, models: [], indisponiveis: [] };
+    }
+    if (this.cached && this.cached.expiresAt > Date.now()) return this.cached.catalog;
+    if (this.loading) return this.loading;
+
+    this.loading = (async () => {
+      const models: { id: string }[] = [];
+      const indisponiveis: LlmProvider[] = [];
+      const vistos = new Set<string>();
+
+      for (const provider of providers) {
+        try {
+          const page = await this.clients[provider]!.models.list({
+            timeout: 10_000,
+            maxRetries: 0,
+          });
+          for (const m of page.data) {
+            const id = catalogId(provider, m.id);
+            if (!id || vistos.has(id)) continue;
+            vistos.add(id);
+            models.push({ id });
+            if (models.length >= 200) break;
+          }
+        } catch {
+          indisponiveis.push(provider);
+        }
+      }
+
+      // Nenhuma credencial respondeu: não existe catálogo para inventar.
+      if (indisponiveis.length === providers.length) {
+        throw new ServiceUnavailableException(
+          'Não foi possível listar os modelos disponíveis nas credenciais configuradas',
+        );
+      }
+
+      const catalog: FirstContactCatalog = {
+        configured: true,
+        models,
+        indisponiveis,
+      };
+      // Falha parcial não fica em cache: o provedor pode voltar no minuto seguinte.
+      if (indisponiveis.length === 0) {
+        this.cached = { expiresAt: Date.now() + 60_000, catalog };
+      }
+      return catalog;
+    })().finally(() => {
+      this.loading = undefined;
+    });
+
+    return this.loading;
+  }
+}
