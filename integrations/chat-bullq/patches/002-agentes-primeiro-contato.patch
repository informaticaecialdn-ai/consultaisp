+import { Body, Controller, Get, Param, Post, UseGuards } from '@nestjs/common';
+import { OrgRole } from '@prisma/client';
+import { JwtAuthGuard, OrgGuard, RolesGuard } from '../../../common/guards';
+import { CurrentOrg, Roles } from '../../../common/decorators';
+import { FirstContactService } from './first-contact.service';
+
+@Controller('ai-agents')
+@UseGuards(JwtAuthGuard, OrgGuard, RolesGuard)
+@Roles(OrgRole.OWNER, OrgRole.ADMIN)
+export class FirstContactController {
+  constructor(private readonly service: FirstContactService) {}
+  @Get('first-contact/models')
+  models() { return this.service.models(); }
+
+  @Post(':id/first-contact-draft')
+  prepare(@CurrentOrg('id') orgId: string, @Param('id') id: string, @Body() body: { context?: unknown }) {
+    return this.service.prepare(orgId, id, body?.context);
+  }
+}
diff --git a/src/modules/ai-agents/llm/first-contact-models.ts b/src/modules/ai-agents/llm/first-contact-models.ts
new file mode 100644
--- /dev/null
+++ b/src/modules/ai-agents/llm/first-contact-models.ts
@@ -0,0 +1,25 @@
+import { ServiceUnavailableException } from '@nestjs/common';
+import type OpenAI from 'openai';
+
+/** Catálogo real da credencial, sem catálogo estático nem substituição de modelo. */
+export class FirstContactModels {
+  private cached?: { expiresAt: number; models: { id: string }[] };
+  private loading?: Promise<{ configured: boolean; models: { id: string }[] }>;
+  constructor(private readonly client: Pick<OpenAI, 'models'>, private readonly configured: boolean) {}
+  async list(): Promise<{ configured: boolean; models: { id: string }[] }> {
+    if (!this.configured) return { configured: false, models: [] };
+    if (this.cached && this.cached.expiresAt > Date.now()) return { configured: true, models: this.cached.models };
+    if (this.loading) return this.loading;
+    this.loading = (async () => {
+      try {
+        const page = await this.client.models.list({ timeout: 10_000, maxRetries: 0 });
+        const models = page.data.filter(m => /^(sakana\/)?fugu(?:-|$)/.test(m.id)).slice(0, 200).map(m => ({ id: m.id.startsWith('sakana/') ? m.id : `sakana/${m.id}` }));
+        this.cached = { expiresAt: Date.now() + 60_000, models };
+        return { configured: true, models };
+      } catch {
+        throw new ServiceUnavailableException('Não foi possível listar os modelos disponíveis na credencial Sakana');
+      }
+    })().finally(() => { this.loading = undefined; });
+    return this.loading;
+  }
+}
