+import { Body, Controller, Param, Post, UseGuards } from '@nestjs/common';
+import { OrgRole } from '@prisma/client';
+import { JwtAuthGuard, OrgGuard, RolesGuard } from '../../../common/guards';
+import { CurrentOrg, Roles } from '../../../common/decorators';
+import { AutonomousPlanService } from './autonomous-plan.service';
+
+@Controller('ai-agents')
+@UseGuards(JwtAuthGuard, OrgGuard, RolesGuard)
+@Roles(OrgRole.OWNER, OrgRole.ADMIN)
+export class AutonomousPlanController {
+  constructor(private readonly service: AutonomousPlanService) {}
+  @Post(':id/autonomous-plan')
+  plan(@CurrentOrg('id') orgId: string, @Param('id') id: string, @Body() body: unknown) {
+    return this.service.plan(orgId, id, body);
+  }
+}
