+import { Logger } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import OpenAI from 'openai';
+import { LlmService } from './llm.service';
+
+jest.mock('openai', () => ({ __esModule: true, default: jest.fn() }));
+describe('planning provider privacy', () => {
+  afterEach(() => jest.restoreAllMocks());
+  it.each(['error', 'tool'])('does not log provider data in the %s path', async mode => {
+    const secret = 'PRIVATE_CUSTOMER_DATA';
+    const create = jest.fn();
+    if (mode === 'error') create.mockRejectedValue(Object.assign(new Error(secret), { status: 400 }));
+    else create.mockResolvedValue({ model: 'fugu', choices: [{ finish_reason: 'tool_calls', message: { content: '', tool_calls: [{ id: 'x', type: 'function', function: { name: 'send', arguments: secret } }] } }] });
+    (OpenAI as unknown as jest.Mock).mockImplementation(() => ({ chat: { completions: { create } }, models: {} }));
+    const logger = [jest.spyOn(Logger.prototype, 'error'), jest.spyOn(Logger.prototype, 'debug'), jest.spyOn(Logger.prototype, 'warn')];
+    logger.forEach(spy => spy.mockImplementation(() => undefined));
+    const config = { get: (key: string) => key === 'SAKANA_API_KEY' ? 'fake-test-key' : undefined } as unknown as ConfigService;
+    const service = new LlmService(config);
+    await expect(service.complete({ modelId: 'sakana/fugu', messages: [{ role: 'user', content: secret }], privacySafeErrors: true, timeoutMs: 12000, maxRetries: 0, maxTokens: 600 })).rejects.not.toThrow(secret);
+    expect(create).toHaveBeenCalledTimes(1);
+    expect(create.mock.calls[0][1]).toEqual({ timeout: 12000, maxRetries: 0 });
+    expect(JSON.stringify(logger.map(spy => spy.mock.calls))).not.toContain(secret);
+  });
+});
