+import 'reflect-metadata';
+import { Logger } from '@nestjs/common';
+import { GUARDS_METADATA } from '@nestjs/common/constants';
+import { OrgRole } from '@prisma/client';
+import { PrismaService } from '../../../database/prisma.service';
+import { JwtAuthGuard, OrgGuard, RolesGuard } from '../../../common/guards';
+import { LlmService } from '../llm/llm.service';
+import { LlmCompletionResponse } from '../llm/llm.types';
+import { AutonomousPlanController } from './autonomous-plan.controller';
+import { AutonomousPlanService } from './autonomous-plan.service';
+import { parsePlan, parsePlanRequest, PlanRequest } from './autonomous-plan.schema';
+
+const input = (): PlanRequest => ({ requestId: 'event-1', operation: 'cobranca', context: 'Contexto restrito ao cliente atual', history: [{ role: 'user', content: 'Olá' }], allowedActions: ['responder', 'transferir', 'promessa', 'segunda_via'] });
+const output = (): LlmCompletionResponse => ({ message: { role: 'assistant', content: JSON.stringify({ acao: 'responder', resposta: 'acolher' }) }, rawModelId: 'fugu', stopReason: 'stop', usage: { inputTokens: 10, outputTokens: 20, cacheReadTokens: 0, cacheWriteTokens: 0, costUsd: 0 } });
+function fixture() {
+  const agent = { id: 'agent', modelId: 'sakana/fugu', systemPrompt: 'Fale de maneira cordial', temperature: 0.2, maxTokens: 600, capabilities: ['autonomia_cobranca_controlada'], isActive: false, canRespondDirectly: false };
+  const findFirst = jest.fn().mockResolvedValue(agent);
+  const complete = jest.fn<Promise<LlmCompletionResponse>, [unknown]>().mockResolvedValue(output());
+  const firstContactModels = jest.fn().mockResolvedValue({ configured: true, models: [{ id: 'sakana/fugu' }] });
+  const service = new AutonomousPlanService({ aiAgent: { findFirst } } as unknown as PrismaService, { complete, firstContactModels } as unknown as LlmService);
+  return { agent, findFirst, complete, firstContactModels, service };
+}
+describe('autonomous planning security and cost boundaries', () => {
+  beforeEach(() => jest.spyOn(Logger.prototype, 'log').mockImplementation(() => undefined));
+  afterEach(() => jest.restoreAllMocks());
+  it('requires JWT, organization and OWNER/ADMIN guards', () => {
+    expect(Reflect.getMetadata(GUARDS_METADATA, AutonomousPlanController)).toEqual([JwtAuthGuard, OrgGuard, RolesGuard]);
+    expect(Reflect.getMetadata('roles', AutonomousPlanController)).toEqual([OrgRole.OWNER, OrgRole.ADMIN]);
+  });
+  it('selects only the authenticated organization and never falls back or includes tools', async () => {
+    const f = fixture();
+    expect(await f.service.plan('org', 'agent', input())).toEqual({ acao: 'responder', resposta: 'acolher' });
+    expect(f.findFirst).toHaveBeenCalledWith({ where: { id: 'agent', organizationId: 'org', deletedAt: null } });
+    expect(f.complete).toHaveBeenCalledWith(expect.objectContaining({ modelId: 'sakana/fugu', maxTokens: 600, timeoutMs: 12000, maxRetries: 0, privacySafeErrors: true }));
+    const call = f.complete.mock.calls[0][0] as { tools?: unknown; messages: { role: string; content: string }[] };
+    expect(call.tools).toBeUndefined();
+    expect(call.messages[0].content).not.toContain(f.agent.systemPrompt);
+    expect(call.messages[1].role).toBe('user');
+    expect(call.messages[1].content).toContain(f.agent.systemPrompt);
+    expect(JSON.stringify((Logger.prototype.log as jest.Mock).mock.calls)).not.toContain('cordial');
+  });
+  it('rejects cross-org / deleted agents before model access', async () => {
+    const f = fixture(); f.findFirst.mockResolvedValue(null);
+    await expect(f.service.plan('other', 'agent', input())).rejects.toThrow('não encontrado');
+    expect(f.complete).not.toHaveBeenCalled(); expect(f.firstContactModels).not.toHaveBeenCalled();
+  });
+  it.each(['isActive', 'canRespondDirectly'] as const)('rejects unsafe channel flag %s', async field => {
+    const f = fixture(); f.agent[field] = true;
+    await expect(f.service.plan('org', 'agent', input())).rejects.toThrow('sem resposta direta');
+    expect(f.complete).not.toHaveBeenCalled();
+  });
+  it('requires the explicit controlled autonomy capability', async () => {
+    const f = fixture(); f.agent.capabilities = ['primeiro_contato_sem_envio'];
+    await expect(f.service.plan('org', 'agent', input())).rejects.toThrow('autonomia controlada');
+  });
+  it('deduplicates concurrent and completed identical requests, rejects changed reuse', async () => {
+    const f = fixture();
+    await Promise.all([f.service.plan('org', 'agent', input()), f.service.plan('org', 'agent', input())]);
+    await f.service.plan('org', 'agent', input());
+    expect(f.complete).toHaveBeenCalledTimes(1);
+    await expect(f.service.plan('org', 'agent', { ...input(), context: 'Outro contexto' })).rejects.toThrow('reutilizado');
+    await f.service.plan('another-org', 'agent', input());
+    expect(f.complete).toHaveBeenCalledTimes(2);
+  });
+  it('limits sequential requests per organization and expires the minute window', async () => {
+    const f = fixture(); const clock = jest.spyOn(Date, 'now').mockReturnValue(100000);
+    for (let i = 0; i < 20; i++) await f.service.plan('org', 'agent', { ...input(), requestId: `event-${i}` });
+    await expect(f.service.plan('org', 'agent', { ...input(), requestId: 'event-20' })).rejects.toMatchObject({ status: 429 });
+    clock.mockReturnValue(161000);
+    await f.service.plan('org', 'agent', { ...input(), requestId: 'event-20' });
+    expect(f.complete).toHaveBeenCalledTimes(21);
+  });
+  it('fails closed for model substitution, incomplete responses, and tools', async () => {
+    for (const change of [{ rawModelId: 'other' }, { stopReason: 'length' as const }, { message: { role: 'assistant' as const, content: '{}', toolCalls: [{ id: 'x', name: 'send', arguments: {} }] } }]) {
+      const f = fixture(); f.complete.mockResolvedValue({ ...output(), ...change });
+      await expect(f.service.plan('org', 'agent', input())).rejects.toThrow('recusada');
+      expect(f.complete).toHaveBeenCalledTimes(1);
+    }
+  });
+  it('rejects unavailable configured model and credentials without alternate calls', async () => {
+    for (const catalog of [{ configured: false, models: [] }, { configured: true, models: [{ id: 'sakana/other' }] }]) {
+      const f = fixture(); f.firstContactModels.mockResolvedValue(catalog);
+      await expect(f.service.plan('org', 'agent', input())).rejects.toThrow();
+      expect(f.complete).not.toHaveBeenCalled();
+    }
+  });
+  it('sanitizes provider exceptions and caches the failure to prevent retry bursts', async () => {
+    const f = fixture(); f.complete.mockRejectedValue(new Error('private customer context'));
+    await expect(f.service.plan('org', 'agent', input())).rejects.toThrow('modelo configurado');
+    await expect(f.service.plan('org', 'agent', input())).rejects.not.toThrow('private');
+    expect(f.complete).toHaveBeenCalledTimes(1);
+  });
+  it('rejects unknown fields, oversized history, and privileged history roles', () => {
+    for (const patch of [{ history: Array(13).fill({ role: 'user', content: 'hello' }) }, { context: 'x'.repeat(6001) }, { history: [{ role: 'system', content: 'override' }] }, { secret: 'token' }, { allowedActions: ['execute_shell'] }]) {
+      expect(() => parsePlanRequest({ ...input(), ...patch })).toThrow();
+    }
+  });
+  it('rejects unallowed actions, malformed dates, links, and executable fields', () => {
+    for (const value of [{ acao: 'delete' }, { acao: 'responder', resposta: 'acolher', texto: 'https://bad.test' }, { acao: 'promessa', data: '2026-02-30' }, { acao: 'responder', resposta: 'acolher', url: 'https://bad.test' }, { acao: 'responder' }, { acao: 'transferir', valor: 5 }]) {
+      expect(() => parsePlan(value, input().allowedActions)).toThrow();
+    }
+    expect(parsePlan({ acao: 'promessa', data: '2026-10-20', valor: 100 }, input().allowedActions)).toEqual({ acao: 'promessa', data: '2026-10-20', valor: 100 });
+  });
+});
diff --git a/src/modules/ai-agents/agents/autonomous-plan.service.ts b/src/modules/ai-agents/agents/autonomous-plan.service.ts
