# Required
DATABASE_URL=postgresql://consulta:YOUR_PASSWORD@postgres:5432/consultaisp
DB_PASSWORD=YOUR_SECURE_PASSWORD
SESSION_SECRET=YOUR_RANDOM_SECRET

# Optional
PORT=5000
LOG_LEVEL=info

# LGPD — Hash de CPF/endereco para rede colaborativa
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICO: NUNCA altere este valor apos entrar em producao.
NETWORK_CPF_SALT=

# LGPD — Codigo de provedor parceiro (pseudonimo pareado por observador, HMAC)
# Gere com o mesmo comando acima. Sem ele, deriva do SESSION_SECRET — e trocar
# a sessao passa a trocar todos os codigos da rede.
# NUNCA altere apos entrar em producao sem mover o valor antigo para
# PARTNER_CODE_SECRET_PREVIOUS (lista separada por virgula): e o que permite ao
# superadmin resolver codigos gravados antes da troca.
PARTNER_CODE_SECRET=
PARTNER_CODE_SECRET_PREVIOUS=

# External services (required for full functionality)
RESEND_API_KEY=
ASAAS_API_KEY=
# Token de autenticacao do webhook Asaas (copie do painel Asaas > Configuracoes > Integracoes > Webhooks)
ASAAS_WEBHOOK_TOKEN=
# AI (compativel com OpenAI SDK — DeepSeek, OpenAI, etc.)
# Para DeepSeek: API_KEY=sk-... | BASE_URL=https://api.deepseek.com | MODEL=deepseek-chat
# Para OpenAI:  API_KEY=sk-proj-... | BASE_URL= (vazio) | MODEL=gpt-4o-mini
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_ANALYSIS_MODEL=deepseek-chat
GOOGLE_MAPS_API_KEY=

# Superadmin seed
SUPERADMIN_EMAIL=master@consultaisp.com.br
SUPERADMIN_PASSWORD=

# SPC Brasil — WebService de Consulta (SOAP). Operador e SENHA DE WEBSERVICE,
# que e diferente da senha do site; a entidade/CDL libera o operador.
# Producao:    https://api.spc.org.br/spc/remoting/ws/consulta/consultaWebService
# Treinamento: https://treinamento.spcbrasil.com.br/spc/remoting/ws/consulta/consultaWebService
# Sem SPC_USERNAME/SPC_PASSWORD a consulta SPC fica desligada (503 na rota).
SPC_USERNAME=
SPC_PASSWORD=
SPC_WSDL_URL=https://api.spc.org.br/spc/remoting/ws/consulta/consultaWebService
# Produto consultado (SPC MIX TOP + = 257). GET /api/admin/spc/produtos lista os do operador, de graca.
SPC_PRODUCT_CODE=257

# LGPD — Email do administrador para alertas de prazo SLA
LGPD_ADMIN_EMAIL=

# Demo data (set to 'true' only in development)
# IMPORTANTE: NODE_ENV=production bloqueia o seed independentemente deste valor.
SEED_DEMO_DATA=false
