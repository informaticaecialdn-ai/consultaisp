# Required
DATABASE_URL=postgresql://consulta:YOUR_PASSWORD@postgres:5432/consultaisp
DB_PASSWORD=YOUR_SECURE_PASSWORD
SESSION_SECRET=YOUR_RANDOM_SECRET

# Optional
PORT=5000
LOG_LEVEL=info

# Dominio da PLATAFORMA. E dele que saem os subdominios de provedor
# (<sub>.<MAIN_DOMAIN>) e e contra ele que o sistema recusa cadastrar um
# subdominio da plataforma como dominio proprio de uma marca white label.
# O mesmo valor e lido por script/dominio-whitelabel.sh.
MAIN_DOMAIN=consultaisp.com.br
# Base absoluta dos links de e-mail quando nao ha dominio de marca nem
# subdominio de provedor. Sem ele, cai em https://<MAIN_DOMAIN>.
APP_URL=

# IP publico DESTE servidor. Aparece so num lugar: a instrucao de DNS em
# /revenda/marca, onde o revendedor le "aponte um registro A para <IP>" antes
# de o certificado da marca dele ser emitido.
# Vazio nao quebra nada — `GET /api/revenda/marca` devolve `dnsIp: null` e a
# tela manda pedir o endereco ao suporte, em vez de inventar um numero. E o
# unico jeito honesto de errar aqui: um IP errado na tela faz o revendedor
# apontar o dominio dele para a maquina de outra pessoa.
SERVER_PUBLIC_IP=

# LGPD — Hash de CPF/endereco para rede colaborativa
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICO: NUNCA altere este valor apos entrar em producao.
NETWORK_CPF_SALT=

# LGPD — Codigo de provedor parceiro (pseudonimo pareado por observador, HMAC)
# Gere com o mesmo comando acima. Sem ele, deriva do SESSION_SECRET — e trocar
# a sessao passa a trocar todos os codigos da rede.
# NUNCA altere apos entrar em producao sem mover o valor antigo para
# PARTNER_CODE_SECRET_PREVIOUS (lista separada por virgula): e o que permite ao
# superadmin resolver codigos gravados antes da troca.
PARTNER_CODE_SECRET=
PARTNER_CODE_SECRET_PREVIOUS=

# External services (required for full functionality)
RESEND_API_KEY=
ASAAS_API_KEY=
# Token de autenticacao do webhook Asaas (copie do painel Asaas > Configuracoes > Integracoes > Webhooks)
# OBRIGATORIO em producao SEMPRE QUE ASAAS_API_KEY estiver preenchida: nesse caso,
# sem o token o processo NAO SOBE (servidor e worker). O webhook e a unica porta
# por onde credito entra no saldo sem ninguem clicar, e sem token o servidor nao
# tem como distinguir uma notificacao do Asaas de um POST forjado.
# Sem chave de API a cobranca esta desligada e fica so um aviso — o webhook nao
# libera nada porque nao consegue reconsultar a cobranca. Cadastre as duas juntas.
# O pm2 congela o .env no start: depois de mexer aqui, `pm2 delete` + `pm2 start`
# pelo ecosystem, nao `pm2 restart`.
ASAAS_WEBHOOK_TOKEN=
# AI (compativel com OpenAI SDK — DeepSeek, OpenAI, etc.)
# Para DeepSeek: API_KEY=sk-... | BASE_URL=https://api.deepseek.com | MODEL=deepseek-chat
# Para OpenAI:  API_KEY=sk-proj-... | BASE_URL= (vazio) | MODEL=gpt-4o-mini
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_ANALYSIS_MODEL=deepseek-chat
GOOGLE_MAPS_API_KEY=

# Superadmin seed
SUPERADMIN_EMAIL=master@consultaisp.com.br
SUPERADMIN_PASSWORD=

# SPC Brasil — WebService de Consulta (SOAP). Operador e SENHA DE WEBSERVICE,
# que e diferente da senha do site; a entidade/CDL libera o operador.
# Producao:    https://api.spc.org.br/spc/remoting/ws/consulta/consultaWebService
# Treinamento: https://treinamento.spcbrasil.com.br/spc/remoting/ws/consulta/consultaWebService
# Sem SPC_USERNAME/SPC_PASSWORD a consulta SPC fica desligada (503 na rota).
SPC_USERNAME=
SPC_PASSWORD=
SPC_WSDL_URL=https://api.spc.org.br/spc/remoting/ws/consulta/consultaWebService
# Produto consultado (SPC MIX TOP + = 257). GET /api/admin/spc/produtos lista os do operador, de graca.
SPC_PRODUCT_CODE=257
# Insumos OPCIONAIS pedidos em toda consulta (codigos separados por virgula; a entidade pode cobrar cada um).
# No 257: 17 protesto · 78 spc-score-12-meses · 77 spc-score-3-meses · 5228 score-cadastro-positivo
#         3082 spc-obito · 5122 renda-presumida-spc · 5142 limite-credito-sugerido
SPC_INSUMOS_OPCIONAIS=

# LGPD — Identificacao do CONTROLADOR na politica publica (/lgpd) e nos avisos
# ao titular. A pagina tem efeito juridico: com estes campos vazios ela publica
# "Consulta ISP Tecnologia Ltda" e o CNPJ placeholder 00.000.000/0000-00, que
# nao identificam ninguem. Preencha com a razao social e o CNPJ REAIS da
# plataforma antes de vender.
# Quando uma marca white label declara responsavel proprio (razao social + CNPJ
# + e-mail de suporte), ela e nomeada como controladora e estes valores passam a
# aparecer como OPERADORA — nunca somem da pagina.
LGPD_EMPRESA=
LGPD_CNPJ=
# Encarregado (DPO). Usado quando a marca nao tem e-mail de suporte proprio.
LGPD_DPO_EMAIL=

# LGPD — Email do administrador para alertas de prazo SLA
LGPD_ADMIN_EMAIL=

# Demo data (set to 'true' only in development)
# IMPORTANTE: NODE_ENV=production bloqueia o seed independentemente deste valor.
SEED_DEMO_DATA=false
